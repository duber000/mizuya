# mizuya — entity, relation, and observation storage.
# All functions take a db.Pool and use the stdlib/db query + scan layer.

petiole main

import "stdlib/crypto"
import "stdlib/datetime"
import "stdlib/db"
import "stdlib/json" as jsonpkg
import "stdlib/slice"
import "stdlib/sqlite"
import "stdlib/string" as strpkg

# validDate reports whether s is a real YYYY-MM-DD calendar date (not
# just the right shape) — used by --since/--until/--as-of so a typo like
# 2026-13-99 is an error instead of a silent match-nothing filter.
func validDate(s: string) bool
    _, err := datetime.Parse(s, datetime.LayoutDate)
    return err equals empty

# openDB opens (or creates) the SQLite database at the given path.
func openDB(dbPath: string) (db.Pool, error)
    return sqlite.OpenPath(dbPath)

# --- Entity CRUD ---

# upsertEntity creates or updates an entity. On update, type/name are replaced
# and the JSON fields summary/tags are merged into the existing data object,
# preserving any observations already recorded.
#
# Append-only belief model: the entities row stays the fast "current view",
# but every upsert also appends the post-update state to entity_history in
# the same transaction, so the previous conception of the entity is never
# lost — it is resolved at read time (see listEntityHistory / entityStateAt).
# No-op upserts (state identical to the latest logged version) skip the
# history append so the log is not spammed with duplicates.
func upsertEntity(pool: db.Pool, id: string, etype: string, name: string, summary: string, tags: list of string) error
    # Fail-closed secret gate on the stored summary (covers import-openwiki,
    # whose summaries come from wiki files). A scanner error refuses the write.
    cleanSummary, _, rerr := redactSecrets(summary)
    if rerr isnt empty
        return rerr
    summary = cleanSummary

    tagsJSON := jsonpkg.Bytes(tags)

    # Initial JSON for a freshly-inserted row — build via jsonpkg.Bytes
    # on a map so we never string-concatenate JSON by hand. Observations
    # live in their own table and are joined in at read time.
    initialBytes := jsonpkg.Bytes(map of string to any{
        "summary": summary,
        "tags": tags,
    })

    insertSQL := "INSERT INTO entities (id, type, name, data) VALUES (?, ?, ?, ?) ON CONFLICT(id) DO UPDATE SET type = excluded.type, name = excluded.name, data = json_set(json_set(entities.data, '$.summary', ?), '$.tags', json(?)), updated_at = datetime('now')"

    # Copy the post-update state into the version log, unless it is
    # identical to the latest logged version (latest = newest changed_at,
    # tie-broken by uuid7 id).
    historySQL := "INSERT INTO entity_history (entity_id, type, name, data) SELECT e.id, e.type, e.name, e.data FROM entities e WHERE e.id = ? AND NOT EXISTS (SELECT 1 FROM entity_history h WHERE h.entity_id = e.id AND h.id = (SELECT h2.id FROM entity_history h2 WHERE h2.entity_id = e.id ORDER BY h2.changed_at DESC, h2.id DESC LIMIT 1) AND h.type = e.type AND h.name = e.name AND h.data = e.data)"

    err := db.Transaction(pool, tx =>
        db.TxExec(
            tx,
            insertSQL,
            id,
            etype,
            name,
            initialBytes as string,
            summary,
            tagsJSON as string,
        ) onerr return
        db.TxExec(tx, historySQL, id) onerr return
        return empty
    )
    if err isnt empty
        return err
    return empty

# getEntity fetches an entity by id. Returns an error if no row matches.
func getEntity(pool: db.Pool, id: string) (Entity, error)
    q := "SELECT id, type, name, json(data) AS data, created_at, updated_at FROM entities WHERE id = ?"
    result := db.Query(pool, q, id) |> db.ScanOne of Entity
    return result, empty

# deleteEntity removes an entity and (via ON DELETE CASCADE) its relations
# and embedding row.
func deleteEntity(pool: db.Pool, id: string) error
    db.Exec(pool, "DELETE FROM entities WHERE id = ?", id) onerr return
    return empty

# listEntities returns all entities, optionally filtered by type.
func listEntities(pool: db.Pool, etype: string, limit: int) (list of Entity, error)
    parts := empty list of string
    parts = append(parts, "SELECT id, type, name, json(data) AS data, created_at, updated_at FROM entities")
    args := empty list of any
    if etype isnt empty
        parts = append(parts, "WHERE type = ?")
        args = append(args, etype)
    parts = append(parts, "ORDER BY updated_at DESC")
    if limit > 0
        parts = append(parts, "LIMIT ?")
        args = append(args, limit)
    q := strpkg.Join(parts, " ")
    result := db.Query(pool, q, many args) |> db.ScanAll of Entity
    return result, empty

# --- Observations (JSON-array append) ---

# addObservation inserts a row into the observations table and bumps
# the entity's updated_at so search ranking notices the new content.
# The id default (uuid(7)) is filled in by SQLite — uuid extension
# must be registered before this runs.
#
# supersedes optionally names an existing observation on the same entity
# that this one corrects. The old row is kept (append-only); the link
# lets readers — and the drift command — tell a deliberate correction
# apart from staleness. Empty means "corrects nothing".
#
# The text passes through the fail-closed secret gate (scanner.kuki):
# secrets are redacted in place and the count is returned; a scanner error
# refuses the write entirely.
func addObservation(pool: db.Pool, id: string, text: string, source: string, supersedes: string = "") (int, error)
    exists, err := db.Exists(pool, "SELECT 1 FROM entities WHERE id = ?", id)
    if err isnt empty
        return 0, err
    if not exists
        return 0, error "entity not found: {id}"
    if supersedes isnt empty
        ok, serr := db.Exists(pool, "SELECT 1 FROM observations WHERE id = ? AND entity_id = ?", supersedes, id)
        if serr isnt empty
            return 0, serr
        if not ok
            return 0, error "superseded observation not found on entity {id}: {supersedes}"

    clean, redacted, rerr := redactSecrets(text)
    if rerr isnt empty
        return 0, rerr

    _, ierr := db.Exec(
        pool,
        "INSERT INTO observations (entity_id, text, source, supersedes) VALUES (?, ?, ?, NULLIF(?, ''))",
        id,
        clean,
        source,
        supersedes,
    )
    if ierr isnt empty
        return 0, ierr
    _, uerr := db.Exec(pool, "UPDATE entities SET updated_at = datetime('now') WHERE id = ?", id)
    if uerr isnt empty
        return 0, uerr
    return redacted, empty

# listObservations returns the observations for an entity, newest first.
func listObservations(pool: db.Pool, id: string) (list of ObsRow, error)
    return listObservationsRange(pool, id, "", "")

# listObservationsRange returns the observations for an entity, newest
# first, optionally bounded by YYYY-MM-DD dates (since = on/after,
# until = on/before, whole days inclusive). Empty bounds are unbounded.
func listObservationsRange(pool: db.Pool, id: string, since: string, until: string) (list of ObsRow, error)
    if since isnt empty and not validDate(since)
        return empty list of ObsRow, error "--since must be YYYY-MM-DD, got {since}"
    if until isnt empty and not validDate(until)
        return empty list of ObsRow, error "--until must be YYYY-MM-DD, got {until}"

    parts := empty list of string
    parts = append(
        parts,
        "SELECT id, text, source, at, COALESCE(supersedes, '') AS supersedes FROM observations WHERE entity_id = ?",
    )
    args := list of any{id}
    if since isnt empty
        parts = append(parts, "AND at >= datetime(?)")
        args = append(args, since)
    if until isnt empty
        parts = append(parts, "AND at < datetime(?, '+1 day')")
        args = append(args, until)
    parts = append(parts, "ORDER BY at DESC, id DESC")
    q := strpkg.Join(parts, " ")
    result := db.Query(pool, q, many args) |> db.ScanAll of ObsRow
    return result, empty

# deleteObservation removes a single observation by its uuid7 id.
func deleteObservation(pool: db.Pool, obsID: string) error
    db.Exec(pool, "DELETE FROM observations WHERE id = ?", obsID) onerr return
    return empty

# entityText assembles the concatenated text representation of an entity
# (name + summary + observations), used as input to the toy embedder.
func entityText(pool: db.Pool, id: string) (string, error)
    e, err := getEntity(pool, id)
    if err isnt empty
        return "", err

    parts := list of string{e.Name}

    # Pull summary out of the stored JSON via typed unmarshal.
    ed := jsonpkg.Parse of entityData from e.Data
    if ed.Summary isnt empty
        parts = append(parts, ed.Summary)

    obs := listObservations(pool, id) onerr return "", error
    texts := obs
        |> slice.Filter(o => o.Text isnt empty)
        |> slice.Map(o => o.Text)
    parts = append(parts, many texts)

    return strpkg.Join(parts, " "), empty

# corpusHash returns a hex sha256 over the corpus text. Used to detect
# whether an entity's text has changed since the last embedding pass —
# when it hasn't, we skip the network round-trip to the embed provider.
func corpusHash(text: string) string
    return crypto.SHA256(text)

# storedHash reads the current content_hash for an entity. Returns
# the empty string for unknown ids or NULL hashes (which forces a
# re-embed on the next touch — the safe direction for migrations).
func storedHash(pool: db.Pool, id: string) (string, error)
    q := "SELECT COALESCE(content_hash, '') AS hash FROM entities WHERE id = ?"
    row := db.Query(pool, q, id) |> db.ScanOne of hashRow
    return row.Hash, empty

# setStoredHash records a new content_hash without bumping updated_at —
# called after a successful re-embed. The companion update during
# upsertEntity already moved updated_at.
func setStoredHash(pool: db.Pool, id: string, hash: string) error
    db.Exec(pool, "UPDATE entities SET content_hash = ? WHERE id = ?", hash, id) onerr return
    return empty

# reEmbedIfChanged regenerates the embedding for an entity only when
# its text corpus has changed since the last embedding pass. Returns
# true if a new embedding was computed, false on the cached path.
# Skipping when the hash matches saves a round-trip to the embed
# provider (ollama/openai) on every no-op upsert/observe.
func reEmbedIfChanged(pool: db.Pool, id: string) (bool, error)
    text, err := entityText(pool, id)
    if err isnt empty
        return false, err
    h := corpusHash(text)
    prev := storedHash(pool, id) onerr return false, error
    if prev equals h and prev isnt empty
        return false, empty
    vec := embedText(text) onerr return false, error
    upsertEmbedding(pool, id, vec) onerr return false, error
    setStoredHash(pool, id, h) onerr return false, error
    return true, empty

# --- Tags ---

# addTag appends a string to the entity's $.tags JSON array.
func addTag(pool: db.Pool, id: string, tag: string) error
    q := "UPDATE entities SET data = json_set(data, '$.tags[#]', ?), updated_at = datetime('now') WHERE id = ?"
    db.Exec(pool, q, tag, id) onerr return
    return empty

# --- Entity version history (append-only belief log) ---

# listEntityHistory returns the logged versions of an entity, newest
# first. The current state lives in entities; history holds every prior
# logged state (plus the initial one), so nothing is ever overwritten.
func listEntityHistory(pool: db.Pool, id: string, limit: int) (list of HistoryRow, error)
    if limit <= 0
        limit = 20
    q := "SELECT id, entity_id, type, name, json(data) AS data, changed_at FROM entity_history WHERE entity_id = ? ORDER BY changed_at DESC, id DESC LIMIT ?"
    result := db.Query(pool, q, id, limit) |> db.ScanAll of HistoryRow
    return result, empty

# entityStateAt returns the entity's state as of the end of the given
# YYYY-MM-DD date — the latest logged version from before that day
# ends. Errors when no version existed yet at that point in time.
func entityStateAt(pool: db.Pool, id: string, at: string) (HistoryRow, error)
    if not validDate(at)
        return HistoryRow{}, error "as-of date must be YYYY-MM-DD, got {at}"
    q := "SELECT id, entity_id, type, name, json(data) AS data, changed_at FROM entity_history WHERE entity_id = ? AND changed_at < datetime(?, '+1 day') ORDER BY changed_at DESC, id DESC LIMIT 1"
    result := db.Query(pool, q, id, at) |> db.ScanOne of HistoryRow
    return result, empty

# --- Drift ---

# listDrift returns observations whose entity has a logged version newer
# than the observation — i.e. the entity's conception changed after the
# observation was recorded (append-only model: the change lives in
# entity_history, not in an overwritten field). Observations that a newer
# observation explicitly supersedes are deliberate corrections, not
# drift, and are excluded unless includeSuperseded is true.
func listDrift(pool: db.Pool, limit: int, includeSuperseded: bool) (list of DriftRow, error)
    if limit <= 0
        limit = 50
    parts := list of string{
        "SELECT o.id AS obs_id, o.entity_id AS entity_id, e.name AS entity_name, o.text AS obs_text, o.at AS obs_at, e.updated_at AS entity_updated FROM observations o JOIN entities e ON e.id = o.entity_id WHERE o.distilled = 0 AND EXISTS (SELECT 1 FROM entity_history h WHERE h.entity_id = o.entity_id AND h.changed_at > o.at)",
    }
    if not includeSuperseded
        parts = append(parts, "AND NOT EXISTS (SELECT 1 FROM observations o2 WHERE o2.supersedes = o.id)")
    parts = append(parts, "ORDER BY e.updated_at DESC LIMIT ?")
    q := strpkg.Join(parts, " ")
    result := db.Query(pool, q, limit) |> db.ScanAll of DriftRow
    return result, empty

# --- Relations ---

# relate creates an edge src --rel--> dst. The primary key on
# (src, rel, dst) prevents duplicates.
func relate(pool: db.Pool, src: string, rel: string, dst: string) error
    db.Exec(pool, "INSERT OR IGNORE INTO relations (src, rel, dst) VALUES (?, ?, ?)", src, rel, dst) onerr return
    return empty

# unrelate removes a specific edge.
func unrelate(pool: db.Pool, src: string, rel: string, dst: string) error
    db.Exec(pool, "DELETE FROM relations WHERE src = ? AND rel = ? AND dst = ?", src, rel, dst) onerr return
    return empty

# outgoingContext returns every neighbor reachable in one hop from id
# along an outgoing edge.
func outgoingContext(pool: db.Pool, id: string) (list of ContextRow, error)
    q := "SELECT r.rel AS rel, r.dst AS other, e.name AS name, e.type AS type, COALESCE(e.data ->> '$.summary', '') AS summary FROM relations r JOIN entities e ON e.id = r.dst WHERE r.src = ? ORDER BY r.rel, r.dst"
    result := db.Query(pool, q, id) |> db.ScanAll of ContextRow
    return result, empty

# incomingContext returns every entity that points to id in one hop.
func incomingContext(pool: db.Pool, id: string) (list of ContextRow, error)
    q := "SELECT r.rel AS rel, r.src AS other, e.name AS name, e.type AS type, COALESCE(e.data ->> '$.summary', '') AS summary FROM relations r JOIN entities e ON e.id = r.src WHERE r.dst = ? ORDER BY r.rel, r.src"
    result := db.Query(pool, q, id) |> db.ScanAll of ContextRow
    return result, empty

# --- Fuzzy id suggestions ---

# suggestIds returns up to k entity ids that are approximate matches for
# `query`, ranked by edit distance via the spellfix1 vtab. Used to power
# "did you mean ...?" hints when an exact id lookup fails. Returns
# empty (and no error) if the vtab is empty or no candidates pass
# spellfix's similarity threshold.
func suggestIds(pool: db.Pool, query: string, k: int) (list of string, error)
    if (query is empty) or k <= 0
        return empty list of string, empty
    q := "SELECT word FROM entity_ids_fuzzy WHERE word MATCH ? AND top=?"
    rows := db.Query(pool, q, query, k) |> db.ScanAll of suggestRow
    return rows |> slice.Map(r => r.Word), empty

# refreshFuzzyIds rebuilds the spellfix1 vtab from the current entities
# table. Cheap on small graphs; called from openPool/openMCPPool so
# every command sees up-to-date suggestions even though entities can
# be inserted between sessions.
func refreshFuzzyIds(pool: db.Pool) error
    db.Exec(pool, "DELETE FROM entity_ids_fuzzy") onerr return
    db.Exec(pool, "INSERT INTO entity_ids_fuzzy(word) SELECT id FROM entities") onerr return
    return empty

# reachable returns every entity reachable from id within `depth` hops,
# walking either outgoing edges (fromCol="src", toCol="dst") or incoming
# edges (fromCol="dst", toCol="src"). Implemented via a recursive CTE
# because the upstream `transitive_closure` virtual table is hardcoded
# to integer ids (see ncruces/go-sqlite3/ext/closure), which doesn't
# fit our TEXT slug scheme. Rel labels aren't carried — the walk is
# type-agnostic, any edge counts as a hop.
func reachable(pool: db.Pool, id: string, depth: int, fromCol: string, toCol: string) (list of ReachableRow, error)
    if depth <= 0
        depth = 1
    if fromCol isnt "src" and fromCol isnt "dst"
        return empty list of ReachableRow, error "invalid fromCol: {fromCol}"
    if toCol isnt "src" and toCol isnt "dst"
        return empty list of ReachableRow, error "invalid toCol: {toCol}"
    var q: string
    if fromCol equals "src"
        q = "WITH RECURSIVE reach(id, depth) AS (SELECT dst, 1 FROM relations WHERE src = ? UNION SELECT r.dst, reach.depth + 1 FROM relations r JOIN reach ON r.src = reach.id WHERE reach.depth < ?) SELECT MIN(reach.depth) AS depth, e.id AS other, e.name AS name, e.type AS type, COALESCE(e.data ->> '$.summary', '') AS summary FROM reach JOIN entities e ON e.id = reach.id GROUP BY e.id ORDER BY depth, e.id"
    else
        q = "WITH RECURSIVE reach(id, depth) AS (SELECT src, 1 FROM relations WHERE dst = ? UNION SELECT r.src, reach.depth + 1 FROM relations r JOIN reach ON r.dst = reach.id WHERE reach.depth < ?) SELECT MIN(reach.depth) AS depth, e.id AS other, e.name AS name, e.type AS type, COALESCE(e.data ->> '$.summary', '') AS summary FROM reach JOIN entities e ON e.id = reach.id GROUP BY e.id ORDER BY depth, e.id"
    result := db.Query(pool, q, id, depth) |> db.ScanAll of ReachableRow
    return result, empty

func reachableOutgoing(pool: db.Pool, id: string, depth: int) (list of ReachableRow, error)
    return reachable(pool, id, depth, "src", "dst")

func reachableIncoming(pool: db.Pool, id: string, depth: int) (list of ReachableRow, error)
    return reachable(pool, id, depth, "dst", "src")
