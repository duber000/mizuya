# mizuya — media attachments.
#
# Media files (images, audio, video) attach to entities or spawn
# media-native entities (type = media). Bytes are stored once,
# sha256-addressed under <db dir>/assets/; the media table records the
# derivation plus a caption. The embedding APIs take no video key, so
# video is frame-sampled with ffmpeg (≤ maxVideoFrames, ~1 fps for short
# clips, evenly spaced for long ones) and mean-pooled into a single
# vector in the same space — approximate, but honest, and no new index
# semantics.
#
# Redaction contract, extended honestly to non-text input:
#   - caption and source pass the SAME fail-closed secret gate as
#     observations (redact in place, WARN with detector names only;
#     scanner errors refuse the write).
#   - media BYTES are never scanned — the regex gate is text-only. Every
#     reader is told this via the media.scanned column (always 0 today)
#     and a loud marker in the CLI/MCP output. Nothing claims bytes were
#     vetted.
#   - a media-native entity's name (from --name or the file basename) is
#     redacted by the normal upsert path.
#
# Embedding: one 768-d vector per attachment via the configured provider
# (Ollama + embeddinggemma-2:740m today), stored in the media_vec vec1
# table + media_raw side store — the entity-embedding contract (and its
# tests) is untouched. A provider outage never fails the write: the row
# commits, the vector is deferred (same fail-soft contract as entity
# re-embeds), and callers see EmbedDeferred.

petiole main

import "math"
import "path/filepath"
import "stdlib/crypto"
import "stdlib/db"
import "stdlib/files"
import "stdlib/log"
import "stdlib/shell"
import "stdlib/string" as strpkg
import "strconv"

# maxMediaBytes caps an attachment at 10 MB (base64 transport over MCP
# inflates ~33%; a screenshot or a few minutes of 16 kHz mono audio fits
# comfortably).
const maxMediaBytes: int = 10485760

# maxVideoFrames caps keyframe sampling for video attach/query: short
# clips are sampled at ~1 fps (the model's native rate), long clips get
# that many EVENLY SPACED frames instead of just the first seconds.
const maxVideoFrames: int = 10

type AttachArgs
    Id: string
    File: string
    Kind: string
    Mime: string
    Caption: string
    Name: string
    Source: string

# attachMediaFile reads a host-local file and attaches it.
func attachMediaFile(pool: db.Pool, dbPath: string, args: AttachArgs) (AttachResult, error)
    if args.File is empty
        return AttachResult{}, error "--file is required"
    if not files.Exists(args.File)
        return AttachResult{}, error "file not found: {args.File}"
    bytes := files.Read(args.File) onerr return AttachResult{}, error "cannot read {args.File}: {error:w}"
    return attachMediaBytes(pool, dbPath, args, bytes, args.File)

# attachMediaBytes stores bytes as a media attachment. origin is the
# user-facing filename ("" for base64 input — the asset path is then
# sha256-only, with no extension).
func attachMediaBytes(pool: db.Pool, dbPath: string, args: AttachArgs, bytes: list of byte, origin: string) (AttachResult, error)
    if bytes is empty
        return AttachResult{}, error "refusing to attach an empty file"
    if len(bytes) > maxMediaBytes
        return AttachResult{}, error "file is {len(bytes)} bytes; the limit is {maxMediaBytes} (10 MB)"

    kind := args.Kind
    if kind isnt empty
        kind = strpkg.ToLower(strpkg.TrimSpace(kind))
        if kind isnt "image" and kind isnt "audio" and kind isnt "video"
            return AttachResult{}, error "--kind must be image, audio, or video, got {args.Kind}"
    else
        inferred, iErr := inferMediaKind(origin, args.Mime)
        if iErr isnt empty
            return AttachResult{}, iErr
        kind = inferred

    mime := args.Mime
    if mime is empty
        mime = mimeFor(kind, origin)

    sha := crypto.SHA256Hex(bytes)

    # For video, extract keyframes NOW — before any store writes — so a
    # corrupt or unsupported clip fails the whole attach instead of
    # committing a row we cannot embed.
    var frames: list of list of byte
    if kind equals "video"
        var fErr: error
        frames, fErr = videoFramesForAttach(origin, bytes)
        if fErr isnt empty
            return AttachResult{}, fErr

    # Caption + source pass the same fail-closed gate as observations.
    redacted := 0
    caption := args.Caption
    if caption isnt empty
        c, n, cErr := redactSecrets(caption)
        if cErr isnt empty
            return AttachResult{}, cErr
        caption = c
        redacted = redacted + n
    source := strpkg.ToLower(strpkg.TrimSpace(args.Source))
    if source is empty
        source = "agent"
    srcClean, srcRedacted, sErr := redactSecrets(source)
    if sErr isnt empty
        return AttachResult{}, sErr
    source = srcClean
    redacted = redacted + srcRedacted

    # Entity resolution: attach to an existing entity, or auto-create a
    # content-addressed media-native one (id = media-<sha256[:12]>), which
    # makes re-attaching the same bytes under no --id idempotent.
    entityId := args.Id
    created := false
    if entityId is empty
        entityId = "media-{sha[:12]}"
        name := args.Name
        if name is empty
            name = baseName(origin)
        if name is empty
            name = "media-{sha[:8]}"
        tags := list of string{"media", kind}
        uRedacted, uErr := upsertEntity(pool, entityId, "media", name, caption, tags)
        if uErr isnt empty
            return AttachResult{}, uErr
        redacted = redacted + uRedacted
        created = true
        # Best-effort re-embed of the media-native entity (its corpus is
        # the caption); a provider outage must not fail the write.
        _, rerr := reEmbedIfChanged(pool, entityId)
        if rerr isnt empty
            log.Warn(
                "mizuya: write committed; embedding refresh failed, vector deferred until next touch",
                "id",
                entityId,
                "err",
                "{rerr}",
            )
    else
        getEntity(pool, entityId) onerr return AttachResult{}, error "entity not found: {entityId}{suggestionsFor(pool, entityId)}"

    # Store the bytes once, content-addressed under <db dir>/assets/.
    assetDir := filepath.Join(files.Dirname(dbPath), "assets")
    files.MkDirAll(assetDir) onerr return AttachResult{}, error "cannot create assets directory {assetDir}: {error:w}"
    ext := extOf(origin, mime)
    assetPath := filepath.Join(assetDir, "{sha}{ext}")
    if not files.Exists(assetPath)
        files.WriteBytes(bytes, assetPath) onerr return AttachResult{}, error "cannot write {assetPath}: {error:w}"

    # Idempotent insert: same bytes on the same entity = no-op.
    existing, xErr := findMedia(pool, entityId, sha)
    if (xErr is empty) and existing.Id isnt empty
        return AttachResult{
            Status: "already-attached",
            EntityId: entityId,
            MediaId: existing.Id,
            Kind: existing.Kind,
            Mime: existing.Mime,
            Path: existing.Path,
            Sha256: existing.Sha256,
            Bytes: existing.Bytes,
            Redacted: redacted,
            BytesScanned: false,
        }, empty

    db.Exec(
        pool,
        "INSERT INTO media (entity_id, kind, mime, path, sha256, bytes, caption, scanned, source) VALUES (?, ?, ?, ?, ?, ?, ?, 0, ?)",
        entityId,
        kind,
        mime,
        assetPath,
        sha,
        len(bytes),
        caption,
        source,
    ) onerr return AttachResult{}, error "cannot store media row: {error:w}"

    row, qErr := findMedia(pool, entityId, sha)
    if qErr isnt empty
        return AttachResult{}, qErr

    # Fail-soft embed, same contract as entity re-embeds.
    embedDeferred := true
    var vec: list of float64
    var vErr: error
    if kind equals "video"
        vec, vErr = embedVideoFrames(frames)
    else
        vec, vErr = embedMedia(kind, bytes)
    if vErr is empty
        if mErr := upsertMediaEmbedding(pool, row.Id, vec); mErr is empty
            embedDeferred = false
        else
            log.Warn(
                "mizuya: write committed; media embedding store failed, vector deferred until next touch",
                "media_id",
                row.Id,
                "err",
                "{mErr}",
            )
    else
        log.Warn(
            "mizuya: write committed; media embedding deferred until a provider is available",
            "media_id",
            row.Id,
            "err",
            "{vErr}",
        )

    status := "attached"
    if created
        status = "media-native"

    return AttachResult{
        Status: status,
        EntityId: entityId,
        MediaId: row.Id,
        Kind: kind,
        Mime: mime,
        Path: assetPath,
        Sha256: sha,
        Bytes: len(bytes),
        Redacted: redacted,
        BytesScanned: false,
        EmbedDeferred: embedDeferred,
    }, empty

# findMedia returns the media row for (entity, sha256), or a row with an
# empty Id when none exists.
func findMedia(pool: db.Pool, entityId: string, sha: string) (MediaRow, error)
    count := db.Count(pool, "SELECT count(*) FROM media WHERE entity_id = ? AND sha256 = ?", entityId, sha) onerr return MediaRow{}, error
    if count equals 0
        return MediaRow{}, empty
    q := "SELECT id, entity_id, kind, mime, path, sha256, bytes, caption, scanned, source, at FROM media WHERE entity_id = ? AND sha256 = ?"
    row := db.Query(pool, q, entityId, sha) |> db.ScanOne of MediaRow
    return row, empty

# listMedia returns an entity's attachments, newest first. Used by the
# context outputs (CLI text/JSON and the MCP get_context tool/resource).
func listMedia(pool: db.Pool, entityId: string) (list of MediaRow, error)
    q := "SELECT id, entity_id, kind, mime, path, sha256, bytes, caption, scanned, source, at FROM media WHERE entity_id = ? ORDER BY at DESC, id DESC"
    result := db.Query(pool, q, entityId) |> db.ScanAll of MediaRow
    return result, empty

# upsertMediaEmbedding stores (or replaces) the media vector. Mirrors
# upsertEmbedding: vec1 has no UPSERT, so delete + insert on the vtab
# side; the raw bytes live in the plain media_raw side store.
func upsertMediaEmbedding(pool: db.Pool, mediaId: string, vec: list of float64) error
    blob := serializeVec(vec)
    db.Exec(pool, "DELETE FROM media_vec WHERE media_id = ?", mediaId) onerr return
    q := "INSERT INTO media_vec(vector, media_id) VALUES (?, ?)"
    db.Exec(pool, q, blob, mediaId) onerr return
    db.Exec(
        pool,
        "INSERT OR REPLACE INTO media_raw(media_id, model, dim, vec) VALUES (?, ?, ?, ?)",
        mediaId,
        embedModel(),
        len(vec),
        blob,
    ) onerr return
    return empty

# extractVideoFrames samples up to maxFrames keyframes from a video file
# with ffmpeg (which, together with ffprobe, is required for video — the
# multimodal embedding APIs take no video key, so frames are the honest
# approximation). Short clips sample at ~1 fps (the model's native rate);
# clips longer than maxFrames seconds get that many evenly spaced frames.
func extractVideoFrames(file: string, maxFrames: int) (list of list of byte, error)
    if err := shell.RequireCommand("ffmpeg"); err isnt empty
        return empty, error "video embedding requires ffmpeg in PATH: {err:w}"
    if err := shell.RequireCommand("ffprobe"); err isnt empty
        return empty, error "video embedding requires ffprobe in PATH: {err:w}"
    fps := "1"
    probe, pErr := shell.Output(
        "ffprobe",
        "-v",
        "error",
        "-show_entries",
        "format=duration",
        "-of",
        "csv=p=0",
        file,
    )
    if pErr is empty
        d, fErr := strconv.ParseFloat(strpkg.TrimSpace(probe), 64)
        if (fErr is empty) and d > maxFrames as float64
            fps = strconv.FormatFloat(maxFrames as float64 / d, "f" as byte, 4, 64)
    dir, tErr := files.TempDir("mizuya-frames-")
    if tErr isnt empty
        return empty, error "cannot create temp dir for video frames: {tErr:w}"
    defer
        files.DeleteAll(dir) onerr discard
    pattern := filepath.Join(dir, "frame_%03d.jpg")
    cErr := shell.Check(
        "ffmpeg",
        "-v",
        "error",
        "-i",
        file,
        "-vf",
        "fps={fps}",
        "-frames:v",
        "{maxFrames}",
        pattern,
    )
    if cErr isnt empty
        return empty, error "ffmpeg failed on {file}: {cErr:w}"
    entries := files.ListFiles(dir) onerr return empty, error "cannot list extracted frames: {error:w}"

    frames := empty list of list of byte
    for _, entry in entries
        b, bErr := files.Read(filepath.Join(dir, entry))
        if bErr isnt empty
            continue
        frames = append(frames, b)
    if frames is empty
        return empty, error "ffmpeg extracted no frames from {file} (corrupt or unsupported video?)"
    return frames, empty

# videoFramesForAttach returns the keyframes for a video attachment.
# Host files are probed directly; base64/byte input (no usable origin
# path) is written to a temp file first.
func videoFramesForAttach(origin: string, bytes: list of byte) (list of list of byte, error)
    if origin isnt empty and files.Exists(origin)
        return extractVideoFrames(origin, maxVideoFrames)
    f, tErr := files.TempFile("mizuya-video-")
    if tErr isnt empty
        return empty, error "cannot create temp file for video: {tErr:w}"
    defer
        files.Delete(f) onerr discard
    wErr := files.WriteBytes(bytes, f)
    if wErr isnt empty
        return empty, error "cannot write temp video file: {wErr:w}"
    frames, eErr := extractVideoFrames(f, maxVideoFrames)
    return frames, eErr

# meanPoolNormalize averages embedding vectors and re-normalizes the
# result to unit length. Used to collapse per-frame vectors of a video
# into the single vector stored on the attachment.
func meanPoolNormalize(vecs: list of list of float64) list of float64
    if vecs is empty
        return empty list of float64
    dim := len(vecs[0])
    out := make(list of float64, dim)
    count := 0.0
    for _, v in vecs
        if len(v) isnt dim
            continue
        for i, x in v
            out[i] = out[i] + x
        count = count + 1.0
    if count equals 0.0
        return out
    for i from 0 to len(out)
        out[i] = out[i] / count
    sum := 0.0
    for i from 0 to len(out)
        sum = sum + out[i] * out[i]
    if sum equals 0.0
        return out
    norm := math.Sqrt(sum)
    for i from 0 to len(out)
        out[i] = out[i] / norm
    return out

# embedVideoFrames embeds all frames in one batched request and pools
# them into the single video attachment vector.
func embedVideoFrames(frames: list of list of byte) (list of float64, error)
    if frames is empty
        return empty, error "no frames to embed"
    vecs := embedMediaBatch(frames) onerr return empty, error
    return meanPoolNormalize(vecs), empty

# embedStoredMedia embeds a previously-attached media asset by path
# (used by reembed): images/audio go through the direct multimodal
# path, video is frame-sampled and mean-pooled — the SAME derivation as
# attach, so a migration reproduces exactly what `attach` stores.
# Falls back to the file's bytes via a temp file when no readable path
# exists (parity with the attach code path).
func embedStoredMedia(kind: string, path: string, bytes: list of byte) (list of float64, error)
    if kind equals "video"
        var frames: list of list of byte
        var err: error
        if path isnt empty and files.Exists(path)
            frames, err = extractVideoFrames(path, maxVideoFrames)
        else
            frames, err = videoFramesForAttach("", bytes)
        if err isnt empty
            return empty, err
        return embedVideoFrames(frames)
    return embedMedia(kind, bytes)

# embedFileQuery embeds a media file for similarity queries: image/audio
# go through the direct multimodal path; video is frame-sampled and mean
# pooled (the same space, same one vector per row). Returns the vector
# and the detected kind.
func embedFileQuery(file: string) (list of float64, string, error)
    kind, kErr := inferMediaKind(file, "")
    if kErr isnt empty
        return empty list of float64, "", kErr
    if kind equals "video"
        frames, fErr := extractVideoFrames(file, maxVideoFrames)
        if fErr isnt empty
            return empty list of float64, "", fErr
        vec, vErr := embedVideoFrames(frames)
        if vErr isnt empty
            return empty list of float64, "", vErr
        return vec, kind, empty
    bytes := files.Read(file) onerr return empty list of float64, "", error "cannot read {file}: {error:w}"
    vec, vErr := embedMedia(kind, bytes)
    if vErr isnt empty
        return empty list of float64, "", vErr
    return vec, kind, empty

# inferMediaKind maps a filename extension — or, for base64 input with no
# filename, a MIME type — onto image|audio|video.
func inferMediaKind(origin: string, mime: string) (string, error)
    ext := strpkg.ToLower(extOnly(origin))
    if ext equals ".png" or ext equals ".jpg" or ext equals ".jpeg" or ext equals ".gif" or ext equals ".webp" or ext equals ".bmp"
        return "image", empty
    if ext equals ".wav" or ext equals ".mp3" or ext equals ".m4a" or ext equals ".ogg" or ext equals ".flac" or ext equals ".opus" or ext equals ".aac"
        return "audio", empty
    if ext equals ".mp4" or ext equals ".mkv" or ext equals ".mov" or ext equals ".webm" or ext equals ".avi" or ext equals ".m4v"
        return "video", empty
    if ext isnt empty
        return "", error "cannot infer media kind from {origin} (pass --kind image|audio|video)"
    lowerMime := strpkg.ToLower(mime)
    if strpkg.HasPrefix(lowerMime, "image/")
        return "image", empty
    if strpkg.HasPrefix(lowerMime, "audio/")
        return "audio", empty
    if strpkg.HasPrefix(lowerMime, "video/")
        return "video", empty
    return "", error "cannot infer media kind (pass --kind image|audio|video)"

# mimeFor guesses an attachment's MIME type from its extension; used when
# the caller does not supply one.
func mimeFor(kind: string, file: string) string
    ext := strpkg.ToLower(extOnly(file))
    switch ext
        when ".png"
            return "image/png"
        when ".jpg", ".jpeg"
            return "image/jpeg"
        when ".gif"
            return "image/gif"
        when ".webp"
            return "image/webp"
        when ".bmp"
            return "image/bmp"
        when ".wav"
            return "audio/wav"
        when ".mp3"
            return "audio/mpeg"
        when ".m4a"
            return "audio/mp4"
        when ".ogg", ".opus"
            return "audio/ogg"
        when ".flac"
            return "audio/flac"
        when ".aac"
            return "audio/aac"
        when ".mp4", ".m4v"
            return "video/mp4"
        when ".mkv"
            return "video/x-matroska"
        when ".mov"
            return "video/quicktime"
        when ".webm"
            return "video/webm"
        when ".avi"
            return "video/x-msvideo"
        when ""
            return if kind equals "audio" then "audio/wav" else if kind equals "video" then "video/mp4" else "image/png"
        default
            return "application/octet-stream"

# extOf returns the asset extension (dot-prefixed, lowercased) to use for
# the content-addressed filename. Prefers the origin filename's extension;
# falls back to the MIME type when input was base64-only.
func extOf(origin: string, mime: string) string
    ext := strpkg.ToLower(extOnly(origin))
    if ext isnt empty
        return ext
    return mimeExt(mime)

func extOnly(file: string) string
    if file is empty
        return ""
    _, after, ok := strpkg.CutLast(filepath.Base(file), ".")
    if not ok
        return ""
    return ".{strpkg.ToLower(after)}"

func mimeExt(mime: string) string
    switch strpkg.ToLower(mime)
        when "image/png"
            return ".png"
        when "image/jpeg"
            return ".jpg"
        when "image/gif"
            return ".gif"
        when "image/webp"
            return ".webp"
        when "image/bmp"
            return ".bmp"
        when "audio/wav", "audio/x-wav", "audio/wave"
            return ".wav"
        when "audio/mpeg"
            return ".mp3"
        when "audio/mp4", "audio/m4a"
            return ".m4a"
        when "audio/ogg"
            return ".ogg"
        when "audio/flac"
            return ".flac"
        when "audio/aac"
            return ".aac"
        when "video/mp4", "video/m4v", "video/x-m4v"
            return ".mp4"
        when "video/x-matroska", "video/matroska", "video/mkv"
            return ".mkv"
        when "video/quicktime"
            return ".mov"
        when "video/webm"
            return ".webm"
        when "video/x-msvideo", "video/avi"
            return ".avi"
        default
            return ""

func baseName(origin: string) string
    if origin is empty
        return ""
    return filepath.Base(origin)
