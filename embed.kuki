# mizuya — embedding provider abstraction.
#
# Thin wrapper over stdlib/llm/embeddings. Supports any OpenAI-compatible
# /v1/embeddings endpoint (OpenAI, Ollama, Voyage, Cohere, Mistral, …) plus
# a deterministic hash fallback when no provider is configured.
#
# Environment variables:
#   MIZUYA_EMBED_PROVIDER  — "openai", "ollama", "voyage", "cohere", …
#                            (default: "" = hash fallback)
#   MIZUYA_EMBED_URL       — base URL override (default: provider default)
#   MIZUYA_EMBED_MODEL     — model name (default: provider-appropriate)
#   MIZUYA_EMBED_API_KEY   — API key (optional for ollama)

petiole main

import "stdlib/encoding"
import "stdlib/llm/embeddings"
import "stdlib/parse"

# EmbedProvider is the closed set of supported embedding backends.
# ParseEmbedProvider validates the MIZUYA_EMBED_PROVIDER env var.
enum EmbedProvider
    Ollama = "ollama"
    OpenAI = "openai"
    Voyage = "voyage"
    Cohere = "cohere"

# embedConfig is the resolved embedding configuration. Empty provider means
# fall back to hashEmbed and the package-level EmbedDim/EmbedModel constants.
type embedConfig
    provider: string
    url: string
    model: string
    apiKey: string

# EmbedEnv binds the MIZUYA_EMBED_* environment variables via parse.Env.
# The `as` aliases pin the exact env keys: parse.Env folds each alias to
# UPPER_SNAKE under the prefix (e.g. "api_key" -> MIZUYA_EMBED_API_KEY).
type EmbedEnv
    Provider: string as "provider"
    URL: string as "url"
    Model: string as "model"
    ApiKey: string as "api_key"

# loadEmbedConfig reads embedding settings from environment variables and
# applies provider-specific defaults.
func loadEmbedConfig() embedConfig
    result := parse.Env of EmbedEnv from "MIZUYA_EMBED"
    if result is parse.Parsed as r
        provider := r.Value.Provider
        model := r.Value.Model
        if provider equals "ollama" and (model is empty)
            model = "nomic-embed-text"
        if provider equals "openai" and (model is empty)
            model = "text-embedding-3-small"
        return embedConfig{provider: provider, url: r.Value.URL, model: model, apiKey: r.Value.ApiKey}
    else
        # Unreachable: all-string fields never fail to parse. Zero config
        # matches the previous empty-string defaults.
        return embedConfig{}

# embedClient builds the provider client for embed requests. The model
# name is passed through VERBATIM — never through the "provider:model"
# split embedded in embeddings.New — because Ollama model tags carry a
# colon themselves (embeddinggemma-2:740m), which the split would
# mangle into provider="embeddinggemma-2" model="740m".
func embedClient(cfg: embedConfig) embeddings.Client
    client := embeddings.New("")
    client = embeddings.Model(client, cfg.model)
    client = embeddings.Provider(client, cfg.provider)
    if cfg.url isnt empty
        client = embeddings.BaseURL(client, cfg.url)
    if cfg.apiKey isnt empty
        client = embeddings.APIKey(client, cfg.apiKey)
    return client

# embedText converts text into a vector using the configured provider.
# Falls back to hashEmbed when no provider is set.
func embedText(text: string) (list of float64, error)
    cfg := loadEmbedConfig()
    if cfg.provider is empty
        return hashEmbed(text, EmbedDim), empty
    vec32 := embeddings.EmbedOne(embedClient(cfg), text)
    out := make(list of float64, len(vec32))
    for i, v in vec32
        out[i] = v as float64
    return out, empty

# embedMedia embeds one media item through the configured provider. The
# input is an OpenAI-compatible multimodal object — Ollama serving
# embeddinggemma-2 (MIZUYA_EMBED_PROVIDER=ollama,
# MIZUYA_EMBED_MODEL=embeddinggemma-2:740m) accepts
# {"image": "<base64>"} / {"audio": "<base64>"} and returns a unit-norm
# 768-dimensional vector in the same shared space as text. (Video has no
# multimodal key in the API — keyframes are a separate, later ingest
# path.)
#
# Fails closed when no provider is configured: the hash fallback has no
# media path, and silently storing a garbage vector is worse than
# refusing. Callers treat this as a deferral (the row is committed; the
# vector lands on a later touch) — same contract as entity embeddings.
func embedMedia(kind: string, bytes: list of byte) (list of float64, error)
    cfg := loadEmbedConfig()
    if cfg.provider is empty
        return empty, error "media embeddings require a multimodal provider (MIZUYA_EMBED_PROVIDER=ollama MIZUYA_EMBED_MODEL=embeddinggemma-2:740m); none configured"
    input := map of string to string{kind: encoding.Base64Encode(bytes)}
    resp := embeddings.EmbedRaw(embedClient(cfg), input) onerr return empty, error "media embed request failed: {error:w}"
    if resp.Data is empty
        return empty, error "media embed returned no vectors"
    vec32 := resp.Data[0].Embedding
    out := make(list of float64, len(vec32))
    for i, v in vec32
        out[i] = v as float64
    return out, empty

# embedModel returns the model identifier for the current provider,
# used when storing the model tag alongside the embedding.
func embedModel() string
    cfg := loadEmbedConfig()
    if cfg.provider is empty
        return EmbedModel
    return cfg.model
