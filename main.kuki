# mizuya — SQLite-backed knowledge graph with FTS5 + cosine similarity.
#
# A runnable Kukicha example that demonstrates:
#   * stdlib/sqlite + stdlib/db for schema, CRUD, and JSON columns
#   * native SQLite FTS5 (BM25 ranking, content= virtual tables, triggers)
#   * sqlite.CreateFunction to register a pure-Kukicha cosine-distance UDF
#   * a toy deterministic embedder so `similar` works with zero external deps
#
# Usage:
#   kukicha run examples/mizuya/ -- init
#   kukicha run examples/mizuya/ -- upsert --id kukicha --type project --name "Kukicha Language" --summary "Go superset with pipes and onerr" --tags lang,compiler
#   kukicha run examples/mizuya/ -- upsert --id sqlite  --type tool    --name "SQLite"            --summary "Embedded SQL database" --tags db,embedded
#   kukicha run examples/mizuya/ -- relate --src kukicha --rel uses --dst sqlite
#   kukicha run examples/mizuya/ -- observe --id kukicha --text "Added pipe operator support"
#   kukicha run examples/mizuya/ -- search --query "embedded database"
#   kukicha run examples/mizuya/ -- context --id kukicha
#   kukicha run examples/mizuya/ -- similar --text "fast database"

petiole main

skill Mizuya
    description: "SQLite-backed knowledge graph with full-text search (FTS5) and cosine-similarity vector search. Use when an agent needs persistent memory for entities, relations, and observations — e.g. tracking projects, tools, people, concepts and how they connect. Subcommands: init, upsert, relate, observe, search, context, similar, mcp."
    version: "0.1.0"

import "context"
import "os"
import "os/exec"
import "stdlib/cli"
import "stdlib/color"
import "stdlib/db"
import "stdlib/errors" as errs
import "stdlib/files"
import "stdlib/input"
import "stdlib/log"
import "stdlib/parse"
import "stdlib/regex"
import "stdlib/sqlite"
import "stdlib/string" as strpkg
import "stdlib/term"
import "time"

import "github.com/ncruces/go-sqlite3/ext/fts5" as fts5ext
import "github.com/ncruces/go-sqlite3/ext/regexp" as regexpext
import "github.com/ncruces/go-sqlite3/ext/spellfix1" as spellfixext
import "github.com/ncruces/go-sqlite3/ext/stats" as statsext
import "github.com/ncruces/go-sqlite3/ext/unicode" as unicodeext
import "github.com/ncruces/go-sqlite3/ext/uuid" as uuidext
import "github.com/ncruces/go-sqlite3/ext/vec1" as vec1ext

# validEntityTypes is surfaced in CLI flag help and MCP tool schemas.
# Built from AllEntityType() so it stays in sync with the enum declaration.
func validEntityTypes() string
    types := empty list of string
    for t in AllEntityType()
        types = append(types, t.String())
    return strpkg.Join(types, ", ")

func main()
    cli.New("mizuya")
        |> cli.Description("mizuya — SQLite-backed knowledge graph (FTS5 + cosine similarity)")
        |> cli.Version("0.1.0")
        |> cli.GlobalFlag("db", "Database path", ".mizuya/mizuya.db")
        |> cli.BoolGlobalFlag("json", "JSON output", false)
        |> cli.WithCommands(
            makeInitCmd(),
            makeUpsertCmd(),
            makeObserveCmd(),
            makeRelateCmd(),
            makeSearchCmd(),
            makeContextCmd(),
            makeSimilarCmd(),
            makeListCmd(),
            makeMCPCmd(),
            makeImportOpenWikiCmd(),
            makeDistillCmd(),
            makeDriftCmd(),
        )
        |> cli.Run()

func makeInitCmd() reference cli.Command
    return cli.NewCommand("init", "Initialize a new mizuya database")
        |> .ActionE(doInit)

func makeUpsertCmd() reference cli.Command
    return cli.NewCommand("upsert", "Create or update an entity")
        |> .StringFlag("id", "Entity id (slug)", "")
        |> .StringFlag("type", "Entity type ({validEntityTypes()})", "concept")
        |> .StringFlag("name", "Human-readable name", "")
        |> .StringFlag("summary", "One-line summary", "")
        |> .StringFlag("tags", "Comma-separated tags", "")
        |> .ActionE(doUpsert)

func makeObserveCmd() reference cli.Command
    return cli.NewCommand("observe", "Append an observation to an entity")
        |> .StringFlag("id", "Entity id", "")
        |> .StringFlag("text", "Observation text", "")
        |> .StringFlag("source", "Observation source", "conversation")
        |> .ActionE(doObserve)

func makeRelateCmd() reference cli.Command
    return cli.NewCommand("relate", "Create a typed edge between two entities")
        |> .StringFlag("src", "Source entity id", "")
        |> .StringFlag("rel", "Relation label (uses, depends_on, part_of, ...)", "related_to")
        |> .StringFlag("dst", "Destination entity id", "")
        |> .ActionE(doRelate)

func makeSearchCmd() reference cli.Command
    return cli.NewCommand("search", "BM25 full-text search across entities (or regex with --regex)")
        |> .StringFlag("query", "FTS5 query (or regex pattern with --regex)", "")
        |> .IntFlag("limit", "Max results", 10)
        |> .BoolFlag("regex", "Treat --query as a regex pattern (matches id, name, data)", false)
        |> .ActionE(doSearch)

func makeContextCmd() reference cli.Command
    return cli.NewCommand("context", "Show an entity with its N-hop neighbors and observations")
        |> .StringFlag("id", "Entity id", "")
        |> .IntFlag("depth", "Hops to traverse via the closure vtable (1 = immediate neighbors)", 1)
        |> .ActionE(doContext)

func makeSimilarCmd() reference cli.Command
    return cli.NewCommand("similar", "Vector similarity search (cosine distance)")
        |> .StringFlag("id", "Use this entity's embedding as the query", "")
        |> .StringFlag("text", "Embed this text and use it as the query", "")
        |> .IntFlag("limit", "Max results (ignored when --threshold is set)", 5)
        |> .IntFlag(
            "threshold",
            "Return everything in the closest N percentile of distances (1-100, 0 = use --limit instead)",
            0,
        )
        |> .ActionE(doSimilar)

func makeListCmd() reference cli.Command
    return cli.NewCommand("list", "List entities (optionally filtered by --type)")
        |> .StringFlag("type", "Filter by type", "")
        |> .IntFlag("limit", "Max results", 50)
        |> .ActionE(doList)

func makeMCPCmd() reference cli.Command
    return cli.NewCommand("mcp", "Start MCP stdio server for AI agent access")
        |> .ActionE(doMCP)

func makeImportOpenWikiCmd() reference cli.Command
    return cli.NewCommand("import-openwiki", "Import an OpenWiki corpus into the knowledge graph")
        |> .RestArg("dir", "Path to a directory containing an openwiki/ folder")
        |> .ActionE(doImportOpenWiki)

func makeDistillCmd() reference cli.Command
    return cli.NewCommand(
        "distill",
        "Select high-reuse observations and feed them to openwiki for promotion to docs",
    )
        |> .StringFlag("dir", "Project directory (passed to openwiki as cwd)", ".")
        |> .StringFlag("openwiki-cmd", "OpenWiki CLI binary", "openwiki")
        |> .IntFlag("min-age-days", "Minimum observation age in days", 7)
        |> .IntFlag("min-observations", "Minimum observations per entity to qualify", 3)
        |> .IntFlag("limit", "Max entities to distill in one run", 10)
        |> .BoolFlag("dry-run", "Print the prompt without calling openwiki", false)
        |> .ActionE(doDistill)

func makeDriftCmd() reference cli.Command
    return cli.NewCommand(
        "drift",
        "Detect observations whose source entity has changed since they were recorded",
    )
        |> .IntFlag("limit", "Max drift rows to report", 50)
        |> .ActionE(doDrift)

# --- Command handlers ---

# pickSuggestion prompts the operator to choose among fuzzy id matches;
# returns "" when non-interactive (JSON mode or no TTY), on cancel, or
# when there are no candidates. The MCP server never uses this — its
# stdio surface is not interactive.
func pickSuggestion(pool: db.Pool, args: cli.Args, id: string) string
    if cli.IsJSON(args) or not term.IsTTY(os.Stdin)
        return ""
    ids, serr := suggestIds(pool, id, 3)
    if serr isnt empty or (ids is empty)
        return ""
    idx := input.Choose("'{id}' not found — did you mean:", ids) onerr return ""
    return ids[idx]

# resolveEntity fetches an entity by id; on a miss with an interactive TTY
# (outside JSON mode), offers fuzzy matches for selection and re-fetches.
func resolveEntity(pool: db.Pool, args: cli.Args, id: string) (Entity, error)
    e := getEntity(pool, id) onerr
        picked := pickSuggestion(pool, args, id)
        if picked equals ""
            return Entity{}, error "entity not found: {id}"
        refetched, rerr := getEntity(pool, picked)
        if rerr isnt empty
            return Entity{}, rerr
        return refetched, empty

    return e, empty

# resolveEmbedding fetches an embedding vector by id; on a miss with an
# interactive TTY (outside JSON mode), offers fuzzy matches and re-fetches.
func resolveEmbedding(pool: db.Pool, args: cli.Args, id: string) (list of float64, error)
    v := getEmbedding(pool, id) onerr
        picked := pickSuggestion(pool, args, id)
        if picked equals ""
            return empty list of float64, error "no embedding for {id}"
        refetched, rerr := getEmbedding(pool, picked)
        if rerr isnt empty
            return empty list of float64, rerr
        return refetched, empty

    return v, empty

# observeResolved adds an observation for id; on a miss with an interactive
# TTY (outside JSON mode), offers fuzzy matches and retries with the pick.
func observeResolved(pool: db.Pool, args: cli.Args, id: string, text: string, source: string) error
    aerr := addObservation(pool, id, text, source)
    if aerr equals empty
        return empty
    picked := pickSuggestion(pool, args, id)
    if picked equals ""
        return aerr
    return addObservation(pool, picked, text, source)

# openPool opens the database and registers the vec1 vector extension.
# vec1 ships native vec1_cos_distance and a virtual-table KNN index, so
# we no longer pin MaxOpenConns=1 to host a Kukicha-side UDF.
func openPool(args: cli.Args) (db.Pool, error)
    dbPath := cli.GetString(args, "db")
    files.MkDirAll(files.Dirname(dbPath)) onerr return
    pool := sqlite.OpenWithExtensions(
        dbPath,
        empty map of string to string,
        vec1ext.Register,
        regexpext.Register,
        fts5ext.Register,
        uuidext.Register,
        statsext.Register,
        spellfixext.Register,
        unicodeext.Register,
    ) onerr return
    # Repair databases still on the old vec1 layout (with the vec_raw
    # BLOB metadata column) before any write touches the vector index.
    # No-op on current databases.
    migrateVec1Schema(pool) onerr return
    refreshFuzzyIds(pool) onerr return
    return pool, empty

func doInit(args: cli.Args) error
    dbPath := cli.GetString(args, "db")
    files.MkDirAll(files.Dirname(dbPath)) onerr return errs.Wrap(error, "cannot create database directory")

    pool := sqlite.OpenWithExtensions(
        dbPath,
        empty map of string to string,
        vec1ext.Register,
        fts5ext.Register,
        uuidext.Register,
        spellfixext.Register,
        unicodeext.Register,
    ) onerr return errs.Wrap(error, "cannot open database")

    defer db.Close(pool)

    initDB(pool) onerr return errs.Wrap(error, "cannot initialize schema")

    if cli.IsJSON(args)
        printJSON({"status": "initialized", "db": dbPath})
    else
        print(color.Green("Initialized mizuya database at {dbPath}"))
    return empty

func doUpsert(args: cli.Args) error
    id := cli.GetString(args, "id")
    if id equals ""
        return error "--id is required"
    name := cli.GetString(args, "name")
    if name equals ""
        return error "--name is required"
    etype := cli.GetString(args, "type")
    summary := cli.GetString(args, "summary")
    tags := parseTags(cli.GetString(args, "tags"))

    pool := openPool(args) onerr return errs.Wrap(error, "cannot open database")

    defer db.Close(pool)

    upsertEntity(pool, id, etype, name, summary, tags) onerr return errs.Wrap(error, "cannot upsert entity")

    # Regenerate the embedding only if the corpus actually changed.
    reEmbedIfChanged(pool, id) onerr return errs.Wrap(error, "cannot refresh embedding")

    e := getEntity(pool, id) onerr return errs.Wrap(error, "cannot fetch upserted entity")

    if cli.IsJSON(args)
        printJSON(e)
    else
        print("{color.Green("upserted")} {color.Bold(id)}  {color.Dim("({etype})")} {name}")
    return empty

func doObserve(args: cli.Args) error
    id := cli.GetString(args, "id")
    text := cli.GetString(args, "text")
    if id equals "" or text equals ""
        return error "--id and --text are required"
    source := strpkg.Or(cli.GetString(args, "source"), "conversation")

    pool := openPool(args) onerr return errs.Wrap(error, "cannot open database")

    defer db.Close(pool)

    observeResolved(pool, args, id, text, source) onerr
        return error "cannot add observation: {error:w}{suggestionsFor(pool, id)}"

    # Re-embed: observations are part of the entity's text corpus.
    reEmbedIfChanged(pool, id) onerr return errs.Wrap(error, "cannot refresh embedding")

    if cli.IsJSON(args)
        printJSON({"status": "observed", "id": id, "text": text})
    else
        print("{color.Green("observed")} {color.Bold(id)}  {color.Dim(text)}")
    return empty

func doRelate(args: cli.Args) error
    src := cli.GetString(args, "src")
    rel := cli.GetString(args, "rel")
    dst := cli.GetString(args, "dst")
    if src equals "" or rel equals "" or dst equals ""
        return error "--src, --rel, and --dst are required"

    pool := openPool(args) onerr return errs.Wrap(error, "cannot open database")

    defer db.Close(pool)

    relate(pool, src, rel, dst) onerr return errs.Wrap(error, "cannot create relation")

    if cli.IsJSON(args)
        printJSON({"status": "related", "src": src, "rel": rel, "dst": dst})
    else
        print(
            "{color.Green("related")} {color.Bold(src)} {color.Dim("--{rel}->")} {color.Bold(dst)}",
        )
    return empty

func doSearch(args: cli.Args) error
    query := cli.GetString(args, "query")
    if query equals ""
        return error "--query is required"
    limit := cli.GetIntOr(args, "limit", 10)

    pool := openPool(args) onerr return errs.Wrap(error, "cannot open database")

    defer db.Close(pool)

    useRegex := cli.GetBool(args, "regex")
    hits := empty list of SearchHit
    if useRegex
        hits = regexSearch(pool, query, limit) onerr return errs.Wrap(error, "regex search failed")
    else
        hits = hybridSearch(pool, query, limit) onerr return errs.Wrap(error, "search failed")

    if cli.IsJSON(args)
        printJSON(hits)
    else
        if useRegex
            print("{color.Bold("regex:")} {query}")
        else
            print("{color.Bold("search:")} {query}")
        printSearchHits(hits)
    return empty

func doContext(args: cli.Args) error
    id := cli.GetString(args, "id")
    if id equals ""
        return error "--id is required"

    pool := openPool(args) onerr return errs.Wrap(error, "cannot open database")

    defer db.Close(pool)

    depth := cli.GetIntOr(args, "depth", 1)
    if depth < 1
        depth = 1

    e := resolveEntity(pool, args, id) onerr
        return error "{error:w}{suggestionsFor(pool, id)}"

    obs := listObservations(pool, id) onerr return errs.Wrap(error, "cannot read observations")

    if depth > 1
        renderDeepContext(args, pool, e, id, depth, obs) onerr return
        return
    renderShallowContext(args, pool, e, id, obs) onerr return
    return empty

func renderShallowContext(args: cli.Args, pool: db.Pool, e: Entity, id: string, obs: list of ObsRow) error
    outgoing := outgoingContext(pool, id) onerr return errs.Wrap(error, "cannot read outgoing")

    incoming := incomingContext(pool, id) onerr return errs.Wrap(error, "cannot read incoming")

    if cli.IsJSON(args)
        printJSON(map of string to any{
            "entity": e,
            "outgoing": outgoing,
            "incoming": incoming,
            "observations": obs,
        })
        return
    printContext(e, outgoing, incoming, obs)
    return empty

func renderDeepContext(args: cli.Args, pool: db.Pool, e: Entity, id: string, depth: int, obs: list of ObsRow) error
    outReach := reachableOutgoing(pool, id, depth) onerr return errs.Wrap(error, "cannot read outgoing closure")

    inReach := reachableIncoming(pool, id, depth) onerr return errs.Wrap(error, "cannot read incoming closure")

    if cli.IsJSON(args)
        printJSON(map of string to any{
            "entity": e,
            "depth": depth,
            "outgoing": outReach,
            "incoming": inReach,
            "observations": obs,
        })
        return
    printReachableContext(e, depth, outReach, inReach, obs)
    return empty

func doSimilar(args: cli.Args) error
    id := cli.GetString(args, "id")
    text := cli.GetString(args, "text")
    if id equals "" and text equals ""
        return error "either --id or --text is required"
    limit := cli.GetIntOr(args, "limit", 5)
    threshold := cli.GetIntOr(args, "threshold", 0)

    pool := openPool(args) onerr return errs.Wrap(error, "cannot open database")

    defer db.Close(pool)

    vec := empty list of float64
    if id isnt ""
        v := resolveEmbedding(pool, args, id) onerr
            return error "{error:w}{suggestionsFor(pool, id)}"

        vec = v
    else
        vec = embedText(text) onerr return errs.Wrap(error, "cannot compute embedding")

    hits := empty list of SimilarHit
    if threshold > 0
        hits = similarByPercentile(pool, vec, threshold) onerr return errs.Wrap(error, "similarity query failed")
    else
        hits = similar(pool, vec, limit) onerr return errs.Wrap(error, "similarity query failed")

    if cli.IsJSON(args)
        printJSON(hits)
    else
        header := ""
        if id isnt ""
            header = "similar to: {id}"
        else
            header = "similar to text: {text}"
        if threshold > 0
            header = header + " (closest {threshold}%)"
        print(color.Bold(header))
        printSimilarHits(hits)
    return empty

func doList(args: cli.Args) error
    etype := cli.GetString(args, "type")
    limit := cli.GetIntOr(args, "limit", 50)

    pool := openPool(args) onerr return errs.Wrap(error, "cannot open database")

    defer db.Close(pool)

    rows := listEntities(pool, etype, limit) onerr return errs.Wrap(error, "list failed")

    if cli.IsJSON(args)
        printJSON(rows)
    else
        printEntityList(rows)
    return empty

func doMCP(args: cli.Args) error
    dbPath := cli.GetString(args, "db")
    startMCP(dbPath) onerr return errs.Wrap(error, "MCP server error")
    return empty

# OpenWikiDoc holds a parsed wiki page between the two import passes.
type OpenWikiDoc
    Slug: string
    Body: string

# --- import-openwiki ---

# doImportOpenWiki parses an OpenWiki corpus (openwiki/*.md with OKF front
# matter) into mizuya entities + relations. Each concept doc becomes an
# entity (id = filename stem, type = concept or from front matter, tagged
# "openwiki"); each markdown link [text](other.md) becomes a `references`
# edge. Re-importing is idempotent — upsertEntity is ON CONFLICT, and
# reEmbedIfChanged short-circuits when the content hash hasn't changed.
func doImportOpenWiki(args: cli.Args) error
    rest := cli.GetRest(args, "dir")
    if rest is empty
        return error "usage: mizuya import-openwiki <dir>"
    baseDir := rest[0]

    openwikiDir := files.Join(baseDir, "openwiki")
    if not files.Exists(openwikiDir)
        return error "no openwiki/ directory found at {baseDir}"

    pool := openPool(args) onerr return errs.Wrap(error, "cannot open database")

    defer db.Close(pool)

    entries, lErr := files.Walk(openwikiDir)
    if lErr isnt empty
        return errs.Wrap(lErr, "cannot walk openwiki dir")

    imported := 0
    linked := 0
    # First pass: upsert all entities so links can resolve to any doc
    # regardless of Walk order.
    docs := empty list of OpenWikiDoc
    for entry in entries
        if entry.IsDir or not strpkg.HasSuffix(entry.Name, ".md")
            continue
        # slug = path relative to openwiki/ with .md stripped (e.g.
        # "architecture/overview" for openwiki/architecture/overview.md).
        relPath := strpkg.TrimPrefix(entry.Path, openwikiDir + "/")
        slug := strpkg.TrimSuffix(relPath, ".md")
        raw := files.ReadString(entry.Path) onerr
            log.Warn("import-openwiki: skipping unreadable file", "file", entry.Path, "err", error)
            continue

        fmBlock, body := splitFrontMatter(raw)
        var fm: FrontMatter
        if fmBlock isnt ""
            fm = parse.YAML of FrontMatter from fmBlock onerr
                log.Warn(
                    "import-openwiki: skipping file with bad front matter",
                    "file",
                    entry.Path,
                    "err",
                    error,
                )
                continue

        name := strpkg.Or(fm.title, slug)
        summary := strpkg.Or(fm.description, firstParagraph(body))
        # Validate through the enum so the accepted set stays in sync
        # with EntityType; anything outside it (e.g. front-matter
        # "Reference", "Quickstart") files as a concept, same as before.
        etype := strpkg.Or(strpkg.ToLower(fm.entityType), "concept")
        if _, perr := ParseEntityType(etype); perr isnt empty
            etype = "concept"
        tags := list of string{"openwiki"}
        if fm.entityType isnt ""
            tags = append(tags, strpkg.ToLower(fm.entityType))
        for t in fm.tags
            t = strpkg.TrimSpace(t)
            if t isnt ""
                tags = append(tags, t)

        upsertEntity(pool, slug, etype, name, summary, tags) onerr
            log.Warn("import-openwiki: upsert failed", "slug", slug, "err", error)
            continue

        reEmbedIfChanged(pool, slug) onerr discard
        docs = append(docs, OpenWikiDoc{Slug: slug, Body: body})
        imported = imported + 1

    # Second pass: create references edges now that all entities exist.
    for doc in docs
        slug := doc.Slug
        body := doc.Body
        srcDir := ""
        if slashIdx := strpkg.LastIndex(slug, "/"); slashIdx >= 0
            srcDir = slug[:slashIdx + 1]
        links := extractMarkdownLinks(body)
        for dst in links
            # Skip external URLs, anchors, absolute paths, and directory links.
            if strpkg.HasPrefix(dst, "http") or strpkg.HasPrefix(dst, "#") or strpkg.HasPrefix(dst, "/") or strpkg.HasSuffix(dst, "/")
                continue
            # Resolve relative to the source doc's directory, then strip
            # ../ prefixes and .md to get the full slug.
            dstPath := srcDir + dst
            dstPath = strpkg.ReplaceAll(dstPath, "../", "")
            dstSlug := strpkg.TrimSuffix(dstPath, ".md")
            if dstSlug equals slug
                continue
            # Only relate if the target entity exists (avoid FK violations).
            _, dErr := getEntity(pool, dstSlug)
            if dErr isnt empty
                continue
            relate(pool, slug, "references", dstSlug) onerr
                log.Warn(
                    "import-openwiki: relate failed",
                    "src",
                    slug,
                    "dst",
                    dstSlug,
                    "err",
                    error,
                )
                continue

            linked = linked + 1

    if cli.IsJSON(args)
        printJSON(map of string to any{"status": "imported", "entities": imported, "links": linked})
    else
        print("{color.Green("imported")} {imported} entities, {linked} links from {openwikiDir}")
    return empty

# --- distill ---

# distillRow is one entity selected for distillation with its undistilled
# observations.
type distillRow
    Id: string as "id"
    Name: string as "name"
    ObsCount: int as "obs_count"

# distillObsRow is an observation selected for distillation.
type distillObsRow
    Id: string as "id"
    Text: string as "text"
    EntityId: string as "entity_id"

# doDistill selects entities with many old, undistilled observations,
# assembles a prompt from them, and shells out to `openwiki -p` to
# incorporate the findings into the wiki. Selected observations are then
# marked as distilled so they aren't re-selected.
func doDistill(args: cli.Args) error
    minAge := cli.GetIntOr(args, "min-age-days", 7)
    minObs := cli.GetIntOr(args, "min-observations", 3)
    limit := cli.GetIntOr(args, "limit", 10)
    dryRun := cli.GetBool(args, "dry-run")
    dir := cli.GetString(args, "dir")
    openwikiCmd := cli.GetString(args, "openwiki-cmd")

    pool := openPool(args) onerr return errs.Wrap(error, "cannot open database")

    defer db.Close(pool)

    # Select entities with >= minObs undistilled observations older than
    # the age threshold, ordered by observation count descending.
    q := "SELECT e.id AS id, e.name AS name, COUNT(o.id) AS obs_count FROM entities e JOIN observations o ON o.entity_id = e.id WHERE o.distilled = 0 AND o.at < datetime('now', ?) GROUP BY e.id HAVING COUNT(o.id) >= ? ORDER BY obs_count DESC LIMIT ?"
    candidates := db.Query(pool, q, "-{minAge} days", minObs, limit) |> db.ScanAll of distillRow onerr return errs.Wrap(error, "distill query failed")

    if candidates is empty
        if cli.IsJSON(args)
            printJSON({"status": "no-candidates"})
        else
            print(color.Dim("no entities meet the distillation threshold"))
        return

    # Collect the observations for each candidate and build the prompt.
    promptParts := empty list of string
    promptParts = append(
        promptParts,
        "Incorporate these runtime findings into the project wiki. Each block is an entity followed by observations agents recorded during real sessions. Add relevant details to the appropriate wiki page, preserving technical accuracy.\n",
    )
    allObsIds := empty list of string
    for c in candidates
        promptParts = append(promptParts, "\n## {c.Name} ({c.Id})\n")
        obsQ := "SELECT id, text, entity_id FROM observations WHERE entity_id = ? AND distilled = 0 AND at < datetime('now', ?) ORDER BY at DESC"
        obs := db.Query(pool, obsQ, c.Id, "-{minAge} days") |> db.ScanAll of distillObsRow onerr return errs.Wrap(error, "observations query failed")

        for o in obs
            promptParts = append(promptParts, "- {o.Text}\n")
            allObsIds = append(allObsIds, o.Id)

    prompt := strpkg.Join(promptParts, "")

    if dryRun
        if cli.IsJSON(args)
            printJSON(map of string to any{
                "status": "dry-run",
                "candidates": len(candidates),
                "observations": len(allObsIds),
                "prompt": prompt,
            })
        else
            print(
                color.Bold("dry run — {len(candidates)} entities, {len(allObsIds)} observations"),
            )
            print(prompt)
        return

    if openwikiCmd equals ""
        return error "--openwiki-cmd is required (or use --dry-run)"

    if openwikiCmd isnt "openwiki"
        return error "--openwiki-cmd must be 'openwiki' (got: {openwikiCmd})"

    # Shell out to openwiki with the assembled prompt.
    ctx, cancel := context.WithTimeout(context.Background(), 10 * time.Minute)
    defer cancel()
    cmd := exec.CommandContext(ctx, "openwiki", "-p", prompt)
    cmd.Dir = dir
    out, runErr := cmd.CombinedOutput()
    if runErr isnt empty
        return error "openwiki distill failed: {runErr:w}\n{out}"

    # Mark the selected observations as distilled.
    for obsId in allObsIds
        db.Exec(pool, "UPDATE observations SET distilled = 1 WHERE id = ?", obsId) onerr discard

    if cli.IsJSON(args)
        printJSON(map of string to any{
            "status": "distilled",
            "candidates": len(candidates),
            "observations": len(allObsIds),
            "output": strpkg.TrimSpace(out as string),
        })
    else
        print(
            "{color.Green("distilled")} {len(candidates)} entities, {len(allObsIds)} observations -> {openwikiCmd}",
        )
        print(strpkg.TrimSpace(out as string))
    return empty

# --- drift ---

# driftRow is one observation whose entity has been modified since the
# observation was recorded.
type driftRow
    ObsId: string as "obs_id"
    EntityId: string as "entity_id"
    EntityName: string as "entity_name"
    ObsText: string as "obs_text"
    ObsAt: string as "obs_at"
    EntityUpdated: string as "entity_updated"

# doDrift finds observations whose entity was modified (updated_at or
# content_hash changed) after the observation was recorded. These
# observations may reference stale information and warrant review.
func doDrift(args: cli.Args) error
    limit := cli.GetIntOr(args, "limit", 50)

    pool := openPool(args) onerr return errs.Wrap(error, "cannot open database")

    defer db.Close(pool)

    # An observation is "drifted" if its entity's updated_at is newer
    # than the observation's `at` timestamp — the entity changed after
    # the observation was recorded.
    q := "SELECT o.id AS obs_id, o.entity_id AS entity_id, e.name AS entity_name, o.text AS obs_text, o.at AS obs_at, e.updated_at AS entity_updated FROM observations o JOIN entities e ON e.id = o.entity_id WHERE e.updated_at > o.at AND o.distilled = 0 ORDER BY e.updated_at DESC LIMIT ?"
    rows := db.Query(pool, q, limit) |> db.ScanAll of driftRow onerr return errs.Wrap(error, "drift query failed")

    if rows is empty
        if cli.IsJSON(args)
            printJSON(map of string to any{"status": "no-drift", "count": 0})
        else
            print(color.Dim("no drift detected"))
        return

    if cli.IsJSON(args)
        printJSON(rows)
    else
        print(color.Bold("drift: {len(rows)} stale observations"))
        for r in rows
            print("  {color.Bold(r.EntityId)}  {color.Dim(r.ObsAt)} -> {r.EntityUpdated}")
            print("    {color.Dim(strpkg.Truncate(r.ObsText, 80))}")
    return empty

# FrontMatter is the OKF front-matter shape the openwiki importer reads.
# Unknown keys are ignored; tags accepts both [a, b] and block-list YAML.
type FrontMatter
    title: string as "title"
    description: string as "description"
    entityType: string as "type"
    tags: list of string as "tags"

# splitFrontMatter splits raw markdown into the front-matter YAML text
# (the block between --- delimiters; "" when absent) and the body.
func splitFrontMatter(raw: string) (string, string)
    lines := strpkg.Split(raw, "\n")
    if (lines is empty) or lines[0] isnt "---"
        return "", raw
    i := 1
    for i < len(lines)
        if lines[i] equals "---"
            break
        i = i + 1
    if i >= len(lines)
        return "", raw
    return strpkg.Join(lines[1:i], "\n"), strpkg.Join(lines[i + 1:], "\n")

# firstParagraph returns the first non-heading, non-empty line of the body,
# as a plain-text summary fallback when the description front-matter is absent.
func firstParagraph(body: string) string
    lines := strpkg.Split(body, "\n")
    for line in lines
        t := strpkg.TrimSpace(line)
        if t isnt "" and not strpkg.HasPrefix(t, "#")
            return t
    return ""

# markdownLinkPattern matches [text](target.md) wiki links; used by
# extractMarkdownLinks. Compiled once at package level.
var markdownLinkPattern = regex.MustCompile('\[([^\]]*)\]\(([^)]+\.md)\)')

# extractMarkdownLinks scans body text for [text](target.md) patterns and
# returns the list of target paths.
func extractMarkdownLinks(body: string) list of string
    links := empty list of string
    for groups in markdownLinkPattern.FindAllGroups(body)
        links = append(links, groups[2])
    return links
