# mizuya — shared helpers for the test suite.
#
# Sibling *_test.kuki files see declarations here (sibling-test visibility
# works on v0.86.9+), so the pool helpers live in exactly one place.

petiole main

import "os"
import "path/filepath"
import "stdlib/db"
import "stdlib/sqlite"
import "testing"

import "github.com/ncruces/go-sqlite3/ext/fts5" as fts5ext
import "github.com/ncruces/go-sqlite3/ext/regexp" as regexpext
import "github.com/ncruces/go-sqlite3/ext/spellfix1" as spellfixext
import "github.com/ncruces/go-sqlite3/ext/stats" as statsext
import "github.com/ncruces/go-sqlite3/ext/unicode" as unicodeext
import "github.com/ncruces/go-sqlite3/ext/uuid" as uuidext
import "github.com/ncruces/go-sqlite3/ext/vec1" as vec1ext

# openTestPool creates a fresh temp database with all extensions and the
# full schema. Returns the pool and the temp dir (caller removes it via
# closeTestPool). tb is any testing interface (T for tests, B for benches).
func openTestPool(tb: testing.TB) (db.Pool, string)
    dir, err := os.MkdirTemp("", "mizuya-test-")
    if err isnt empty
        tb.Fatalf("mktemp: %v", err)
        var zeroPool: db.Pool
        return zeroPool, ""
    path := filepath.Join(dir, "test.db")
    pool, oerr := sqlite.OpenWithExtensions(
        path,
        map of string to string{"journal_mode": "WAL"},
        vec1ext.Register,
        regexpext.Register,
        fts5ext.Register,
        uuidext.Register,
        statsext.Register,
        spellfixext.Register,
        unicodeext.Register,
    )
    if oerr isnt empty
        tb.Fatalf("open: %v", oerr)
        var zeroPool: db.Pool
        return zeroPool, ""
    if ierr := initDB(pool); ierr isnt empty
        tb.Fatalf("initDB: %v", ierr)
        var zeroPool: db.Pool
        return zeroPool, ""
    return pool, dir

# closeTestPool closes the pool and removes the temp dir.
func closeTestPool(pool: db.Pool, dir: string)
    db.Close(pool) onerr discard
    os.RemoveAll(dir) onerr discard

# obsRefStr flattens an optional observation-id reference (supersedes /
# superseded_by) to a plain string for assertions: empty when null.
func obsRefStr(s: optional reference string) string
    if s is empty
        return ""
    return dereference s

# isoStampOK reports whether s looks like an ISO 8601 UTC stamp as the
# store writes it: "YYYY-MM-DDTHH:MM:SSZ" (millis = false) or
# "YYYY-MM-DDTHH:MM:SS.sssZ" (millis = true).
func isoStampOK(s: string, millis: bool) bool
    want := 20
    if millis
        want = 24
    if len(s) isnt want
        return false
    seps := map of int to string{4: "-", 7: "-", 10: "T", 13: ":", 16: ":"}
    if millis
        seps[19] = "."
        seps[23] = "Z"
    else
        seps[19] = "Z"
    for i from 0 to len(s)
        if i in seps
            if s[i] isnt seps[i][0]
                return false
            continue
        b := s[i] as uint32
        if b < "0" as byte as uint32 or b > "9" as byte as uint32
            return false
    return true
