# mizuya — shared helpers for the test suite.
#
# Sibling *_test.kuki files see declarations here (sibling-test visibility
# works on v0.86.9+), so the pool helpers live in exactly one place.

petiole main

import "os"
import "path/filepath"
import "stdlib/db"
import "stdlib/sqlite"
import "testing"

import "github.com/ncruces/go-sqlite3/ext/fts5" as fts5ext
import "github.com/ncruces/go-sqlite3/ext/regexp" as regexpext
import "github.com/ncruces/go-sqlite3/ext/spellfix1" as spellfixext
import "github.com/ncruces/go-sqlite3/ext/stats" as statsext
import "github.com/ncruces/go-sqlite3/ext/unicode" as unicodeext
import "github.com/ncruces/go-sqlite3/ext/uuid" as uuidext
import "github.com/ncruces/go-sqlite3/ext/vec1" as vec1ext

# openTestPool creates a fresh temp database with all extensions and the
# full schema. Returns the pool and the temp dir (caller removes it via
# closeTestPool). tb is any testing interface (T for tests, B for benches).
func openTestPool(tb: testing.TB) (db.Pool, string)
    dir, err := os.MkdirTemp("", "mizuya-test-")
    if err isnt empty
        tb.Fatalf("mktemp: %v", err)
        var zeroPool: db.Pool
        return zeroPool, ""
    path := filepath.Join(dir, "test.db")
    pool, oerr := sqlite.OpenWithExtensions(
        path,
        map of string to string{"journal_mode": "WAL"},
        vec1ext.Register,
        regexpext.Register,
        fts5ext.Register,
        uuidext.Register,
        statsext.Register,
        spellfixext.Register,
        unicodeext.Register,
    )
    if oerr isnt empty
        tb.Fatalf("open: %v", oerr)
        var zeroPool: db.Pool
        return zeroPool, ""
    if ierr := initDB(pool); ierr isnt empty
        tb.Fatalf("initDB: %v", ierr)
        var zeroPool: db.Pool
        return zeroPool, ""
    return pool, dir

# openLegacyTestPool builds a database whose tables carry the pre-ISO
# column DEFAULTs found in the field (entities/relations: datetime('now');
# observations/entity_history/media: strftime('%Y-%m-%d %H:%M:%f', 'now')),
# then runs initDB — the same upgrade path a real legacy store takes.
# CREATE TABLE IF NOT EXISTS never rewrites an existing table's DEFAULTs,
# so this pins that INSERTs must set ISO stamps explicitly.
func openLegacyTestPool(tb: testing.TB) (db.Pool, string)
    dir, err := os.MkdirTemp("", "mizuya-legacy-test-")
    if err isnt empty
        tb.Fatalf("mktemp: %v", err)
        var zeroPool: db.Pool
        return zeroPool, ""
    path := filepath.Join(dir, "legacy.db")
    pool, oerr := sqlite.OpenWithExtensions(
        path,
        map of string to string{"journal_mode": "WAL"},
        vec1ext.Register,
        regexpext.Register,
        fts5ext.Register,
        uuidext.Register,
        statsext.Register,
        spellfixext.Register,
        unicodeext.Register,
    )
    if oerr isnt empty
        tb.Fatalf("open: %v", oerr)
        var zeroPool: db.Pool
        return zeroPool, ""
    legacy := list of string{
        "CREATE TABLE entities (id TEXT PRIMARY KEY, type TEXT NOT NULL, name TEXT NOT NULL, data TEXT NOT NULL DEFAULT '{}', content_hash TEXT, created_at TEXT NOT NULL DEFAULT (datetime('now')), updated_at TEXT NOT NULL DEFAULT (datetime('now')), archived_at TEXT)",
        "CREATE TABLE relations (src TEXT NOT NULL REFERENCES entities(id) ON DELETE CASCADE, rel TEXT NOT NULL, dst TEXT NOT NULL REFERENCES entities(id) ON DELETE CASCADE, data TEXT NOT NULL DEFAULT '{}', created_at TEXT NOT NULL DEFAULT (datetime('now')), PRIMARY KEY (src, rel, dst))",
        "CREATE TABLE observations (id TEXT PRIMARY KEY DEFAULT (uuid(7)), entity_id TEXT NOT NULL REFERENCES entities(id) ON DELETE CASCADE, text TEXT NOT NULL, source TEXT NOT NULL DEFAULT 'conversation', at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%d %H:%M:%f', 'now')), distilled INTEGER NOT NULL DEFAULT 0, supersedes TEXT REFERENCES observations(id) ON DELETE SET NULL)",
        "CREATE TABLE entity_history (id TEXT PRIMARY KEY DEFAULT (uuid(7)), entity_id TEXT NOT NULL REFERENCES entities(id) ON DELETE CASCADE, type TEXT NOT NULL, name TEXT NOT NULL, data TEXT NOT NULL DEFAULT '{}', changed_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%d %H:%M:%f', 'now')))",
        "CREATE TABLE media (id TEXT PRIMARY KEY DEFAULT (uuid(7)), entity_id TEXT NOT NULL REFERENCES entities(id) ON DELETE CASCADE, kind TEXT NOT NULL, mime TEXT NOT NULL, path TEXT NOT NULL, sha256 TEXT NOT NULL, bytes INTEGER NOT NULL, caption TEXT NOT NULL DEFAULT '', scanned INTEGER NOT NULL DEFAULT 0, source TEXT NOT NULL DEFAULT 'agent', at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%d %H:%M:%f', 'now')))",
    }
    for s in legacy
        db.Exec(pool, s) onerr
            tb.Fatalf("legacy schema: %v", error)
            var zeroPool: db.Pool
            return zeroPool, ""

    if ierr := initDB(pool); ierr isnt empty
        tb.Fatalf("initDB: %v", ierr)
        var zeroPool: db.Pool
        return zeroPool, ""
    return pool, dir

# closeTestPool closes the pool and removes the temp dir.
func closeTestPool(pool: db.Pool, dir: string)
    db.Close(pool) onerr discard
    os.RemoveAll(dir) onerr discard

# obsRefStr flattens an optional observation-id reference (supersedes /
# superseded_by) to a plain string for assertions: empty when null.
func obsRefStr(s: optional reference string) string
    if s is empty
        return ""
    return dereference s

# isoStampOK reports whether s looks like an ISO 8601 UTC stamp as the
# store writes it: "YYYY-MM-DDTHH:MM:SSZ" (millis = false) or
# "YYYY-MM-DDTHH:MM:SS.sssZ" (millis = true).
func isoStampOK(s: string, millis: bool) bool
    want := 20
    if millis
        want = 24
    if len(s) isnt want
        return false
    seps := map of int to string{4: "-", 7: "-", 10: "T", 13: ":", 16: ":"}
    if millis
        seps[19] = "."
        seps[23] = "Z"
    else
        seps[19] = "Z"
    for i from 0 to len(s)
        if i in seps
            if s[i] isnt seps[i][0]
                return false
            continue
        b := s[i] as uint32
        if b < "0" as byte as uint32 or b > "9" as byte as uint32
            return false
    return true
