# mizuya — phase 3 tests: fail-closed secret gate + idempotent import.
#
# Self-contained on purpose: a *_test.kuki cannot see helpers from a
# sibling *_test.kuki at check time (kukicha limitation), so this file
# carries its own pool helper.

petiole main

import "os"
import "path/filepath"
import "stdlib/db"
import "stdlib/env"
import "stdlib/files"
import "stdlib/sqlite"
import "stdlib/test"
import "testing"

import "github.com/ncruces/go-sqlite3/ext/fts5" as fts5ext
import "github.com/ncruces/go-sqlite3/ext/regexp" as regexpext
import "github.com/ncruces/go-sqlite3/ext/spellfix1" as spellfixext
import "github.com/ncruces/go-sqlite3/ext/stats" as statsext
import "github.com/ncruces/go-sqlite3/ext/unicode" as unicodeext
import "github.com/ncruces/go-sqlite3/ext/uuid" as uuidext
import "github.com/ncruces/go-sqlite3/ext/vec1" as vec1ext

func p3Pool(t: reference testing.T) (db.Pool, string)
    dir, err := os.MkdirTemp("", "mizuya-p3-")
    if err isnt empty
        t.Fatalf("mktemp: %v", err)
        return db.Pool{}, ""
    pool, oerr := sqlite.OpenWithExtensions(
        filepath.Join(dir, "test.db"),
        map of string to string{"journal_mode": "WAL"},
        vec1ext.Register,
        regexpext.Register,
        fts5ext.Register,
        uuidext.Register,
        statsext.Register,
        spellfixext.Register,
        unicodeext.Register,
    )
    if oerr isnt empty
        t.Fatalf("open: %v", oerr)
        return db.Pool{}, ""
    test.AssertNoError(t, initDB(pool))
    return pool, dir

func p3Close(pool: db.Pool, dir: string)
    db.Close(pool) onerr discard
    os.RemoveAll(dir) onerr discard

# --- secret scanner ---

func TestRedactSecretsDetectors(t: reference testing.T)
    sc := NewRegexScanner()

    cases := list of string{
        "aws key AKIAIOSFODNN7EXAMPLE leaked",
        "token ghp_abcdefghijklmnopqrstuvwxyz0123456789ab",
        "openai sk-proj-abcdefghijklmnopqrstuvwxyz12",
        "-----BEGIN RSA PRIVATE KEY-----",
        "password = hunter2hunter2hunter2",
    }
    # classic AWS example key
    # github shape
    # openai shape
    # key header
    # generic assignment

    for c in cases
        findings, err := sc.Scan(c)
        test.AssertNoError(t, err)
        test.AssertTrue(t, findings isnt empty, "expected a finding in: {c}")
        out, redacted, rerr := sc.Redact(c)
        test.AssertNoError(t, rerr)
        test.AssertEqual(t, len(redacted), len(findings))
        test.AssertContains(t, out, "[REDACTED:")
        # The raw secret must be gone from the redacted text.
        for f in redacted
            test.AssertFalse(t, strContains(out, f.Raw), "raw secret still present after redact")

    # Clean text passes through untouched.
    clean := "the duck first appeared in a steamboat"
    out, findings, err := sc.Redact(clean)
    test.AssertNoError(t, err)
    test.AssertEqual(t, len(findings), 0)
    test.AssertEqual(t, out, clean)

func strContains(s: string, sub: string) bool
    return sub isnt empty and strIndex(s, sub) >= 0

func strIndex(s: string, sub: string) int
    for i from 0 to len(s) - len(sub)
        if s[i:i + len(sub)] equals sub
            return i
    return -1

# failScanner is a SecretScanner whose engine always errors — the
# fail-closed contract: error means "could not scan", never "clean".
type failScanner
    dummy: int

func Scan on s: failScanner(text: string) (list of SecretFinding, error)
    return empty list of SecretFinding, error "scanner exploded"

func Redact on s: failScanner(text: string) (string, list of SecretFinding, error)
    return "", empty list of SecretFinding, error "scanner exploded"

func TestScannerFailClosed(t: reference testing.T)
    sc := failScanner{}
    _, err := sc.Scan("anything")
    test.AssertError(t, err)
    _, _, err = sc.Redact("anything")
    test.AssertError(t, err)

func TestRedactSecretsMode(t: reference testing.T)
    # Default mode redacts.
    env.Set("MIZUYA_SECRET_SCAN", "redact") onerr discard
    out, n, err := redactSecrets("key AKIAIOSFODNN7EXAMPLE here")
    test.AssertNoError(t, err)
    test.AssertEqual(t, n, 1)
    test.AssertFalse(t, strContains(out, "AKIAIOSFODNN7EXAMPLE"), "secret must be redacted")

    # Off mode passes through.
    env.Set("MIZUYA_SECRET_SCAN", "off") onerr discard
    out, n, err = redactSecrets("key AKIAIOSFODNN7EXAMPLE here")
    test.AssertNoError(t, err)
    test.AssertEqual(t, n, 0)
    test.AssertContains(t, out, "AKIAIOSFODNN7EXAMPLE")

    # Unknown mode is an error, not a silent default (fail-closed).
    env.Set("MIZUYA_SECRET_SCAN", "maybe") onerr discard
    _, _, err = redactSecrets("hello")
    test.AssertError(t, err)
    env.Unset("MIZUYA_SECRET_SCAN") onerr discard

func TestObservationRedactedAtWrite(t: reference testing.T)
    pool, dir := p3Pool(t)
    defer p3Close(pool, dir)
    env.Unset("MIZUYA_SECRET_SCAN") onerr discard

    test.AssertNoError(
        t,
        upsertEntity(pool, "duck", "concept", "Donald Duck", "s", empty list of string),
    )
    n, _, err := addObservation(pool, "duck", "aws key AKIAIOSFODNN7EXAMPLE was used", "conversation")
    test.AssertNoError(t, err)
    test.AssertEqual(t, n, 1)

    obs, lerr := listObservations(pool, "duck")
    test.AssertNoError(t, lerr)
    test.AssertEqual(t, len(obs), 1)
    test.AssertContains(t, obs[0].Text, "[REDACTED:aws-access-key]")
    test.AssertFalse(
        t,
        strContains(obs[0].Text, "AKIAIOSFODNN7EXAMPLE"),
        "stored text must not contain the secret",
    )

func TestUpsertRedactsSummary(t: reference testing.T)
    pool, dir := p3Pool(t)
    defer p3Close(pool, dir)
    env.Unset("MIZUYA_SECRET_SCAN") onerr discard

    err := upsertEntity(
        pool,
        "deploy",
        "config",
        "Deploy",
        "token = ghp_abcdefghijklmnopqrstuvwxyz0123456789ab in summary",
        empty list of string,
    )
    test.AssertNoError(t, err)
    e, gerr := getEntity(pool, "deploy")
    test.AssertNoError(t, gerr)
    test.AssertContains(t, e.Data, "[REDACTED:github-token]")
    test.AssertFalse(
        t,
        strContains(e.Data, "ghp_abcdefghijklmnopqrstuvwxyz0123456789ab"),
        "stored summary must not contain the token",
    )

# --- idempotent import ---

func writeWiki(t: reference testing.T, base: string)
    dir := filepath.Join(base, "openwiki")
    test.AssertNoError(t, files.MkDirAll(dir))
    test.AssertNoError(t, files.WriteString(
        "---\ntitle: SQLite\ndescription: Embedded SQL database engine\ntype: tool\ntags: [db]\n---\n\nSQLite is a [vec1](vec1.md) friendly embedded database.\n",
        filepath.Join(dir, "sqlite.md"),
    ))
    test.AssertNoError(t, files.WriteString(
        "---\ntitle: vec1\ndescription: Vector extension for KNN search\ntype: tool\n---\n\nvec1 adds KNN to [SQLite](sqlite.md).\n",
        filepath.Join(dir, "vec1.md"),
    ))

func TestImportOpenWikiIdempotent(t: reference testing.T)
    pool, dir := p3Pool(t)
    defer p3Close(pool, dir)
    env.Unset("MIZUYA_SECRET_SCAN") onerr discard

    base := filepath.Join(dir, "wiki")
    writeWiki(t, base)

    imported, linked, err := importOpenWiki(pool, base)
    test.AssertNoError(t, err)
    test.AssertEqual(t, imported, 2)
    test.AssertEqual(t, linked, 2)

    # Re-import the same corpus: same counts, no duplicate edges, and the
    # no-op upserts must not append duplicate history rows.
    imported2, linked2, err := importOpenWiki(pool, base)
    test.AssertNoError(t, err)
    test.AssertEqual(t, imported2, 2)
    test.AssertEqual(t, linked2, 2)

    count, cerr := db.Count(pool, "SELECT count(*) FROM entities")
    test.AssertNoError(t, cerr)
    test.AssertEqual(t, count as int, 2)
    relCount, cerr := db.Count(pool, "SELECT count(*) FROM relations")
    test.AssertNoError(t, cerr)
    test.AssertEqual(t, relCount as int, 2)
    hist, herr := listEntityHistory(pool, "sqlite", 50)
    test.AssertNoError(t, herr)
    test.AssertEqual(t, len(hist), 1)

func TestImportOpenWikiRedactsSecrets(t: reference testing.T)
    pool, dir := p3Pool(t)
    defer p3Close(pool, dir)
    env.Unset("MIZUYA_SECRET_SCAN") onerr discard

    base := filepath.Join(dir, "wiki")
    wdir := filepath.Join(base, "openwiki")
    test.AssertNoError(t, files.MkDirAll(wdir))
    test.AssertNoError(t, files.WriteString(
        "---\ntitle: Deploy\ndescription: uses key AKIAIOSFODNN7EXAMPLE internally\n---\n\nBody.\n",
        filepath.Join(wdir, "deploy.md"),
    ))

    imported, _, err := importOpenWiki(pool, base)
    test.AssertNoError(t, err)
    test.AssertEqual(t, imported, 1)
    e, gerr := getEntity(pool, "deploy")
    test.AssertNoError(t, gerr)
    test.AssertFalse(
        t,
        strContains(e.Data, "AKIAIOSFODNN7EXAMPLE"),
        "imported summary must be redacted",
    )
    test.AssertContains(t, e.Data, "[REDACTED:aws-access-key]")

# --- OKF bundle import ---

# writeOKFBundle writes a minimal OKF v0.2 bundle at <base>/docs: index.md
# + log.md (SPEC §8/§9 metadata) plus two concept docs in different
# sections that cross-link via ../ relative links.
func writeOKFBundle(t: reference testing.T, base: string)
    dir := filepath.Join(base, "docs")
    test.AssertNoError(t, files.MkDirAll(filepath.Join(dir, "reference")))
    test.AssertNoError(t, files.MkDirAll(filepath.Join(dir, "guides")))
    test.AssertNoError(t, files.WriteString(
        "---\nokf_version: \"0.2\"\n---\n\n# Bundle index\n\n* [ARCHITECTURE](reference/ARCHITECTURE.md) - reference/ARCHITECTURE.md\n",
        filepath.Join(dir, "index.md"),
    ))
    test.AssertNoError(t, files.WriteString(
        "# Directory Update Log\n\n## 2026-11-03\n* **Creation**: Added [ARCHITECTURE](reference/ARCHITECTURE.md).\n",
        filepath.Join(dir, "log.md"),
    ))
    test.AssertNoError(t, files.WriteString(
        "---\ntype: Reference\ntitle: Architecture\ndescription: System architecture overview\nresource: /docs/reference/ARCHITECTURE.md\ntags: [architecture]\ngenerated: \{by: mistral-vibe/mistral, at: 2026-11-03T21:00:00Z\}\nstatus: stable\nstale_after: 2027-02-01T00:00:00Z\n---\n\n# Architecture\n\nSee the [install guide](../guides/install.md).\n",
        filepath.Join(dir, "reference", "ARCHITECTURE.md"),
    ))
    test.AssertNoError(t, files.WriteString(
        "---\ntype: Tool\ntitle: Install\ndescription: How to install the thing\n---\n\n# Install\n\nSee [ARCHITECTURE](../reference/ARCHITECTURE.md).\n",
        filepath.Join(dir, "guides", "install.md"),
    ))

func TestImportOKFIdempotent(t: reference testing.T)
    pool, dir := p3Pool(t)
    defer p3Close(pool, dir)
    env.Unset("MIZUYA_SECRET_SCAN") onerr discard

    base := filepath.Join(dir, "proj")
    writeOKFBundle(t, base)

    imported, linked, err := importOKF(pool, base, "docs", "okf")
    test.AssertNoError(t, err)
    test.AssertEqual(t, imported, 2)
    test.AssertEqual(t, linked, 2)

    # index.md / log.md are bundle metadata (SPEC §8/§9), not entities.
    count, cerr := db.Count(pool, "SELECT count(*) FROM entities")
    test.AssertNoError(t, cerr)
    test.AssertEqual(t, count as int, 2)

    # Front-matter mapping: OKF type "Reference" is outside the EntityType
    # enum -> concept; "Tool" binds via the wire key `type` -> tool. The
    # section dir, front-matter type, and status become tags.
    arch, aerr := getEntity(pool, "reference/ARCHITECTURE")
    test.AssertNoError(t, aerr)
    test.AssertEqual(t, arch.Type, "concept")
    test.AssertContains(t, arch.Data, "\"okf\"")
    test.AssertContains(t, arch.Data, "\"reference\"")
    test.AssertContains(t, arch.Data, "\"status:stable\"")
    test.AssertContains(t, arch.Data, "\"architecture\"")
    inst, ierr := getEntity(pool, "guides/install")
    test.AssertNoError(t, ierr)
    test.AssertEqual(t, inst.Type, "tool")
    test.AssertContains(t, inst.Data, "\"guides\"")

    # Re-import the same bundle: same counts, no duplicate edges, and the
    # no-op upserts must not append duplicate history rows.
    imported2, linked2, err := importOKF(pool, base, "docs", "okf")
    test.AssertNoError(t, err)
    test.AssertEqual(t, imported2, 2)
    test.AssertEqual(t, linked2, 2)

    relCount, cerr := db.Count(pool, "SELECT count(*) FROM relations")
    test.AssertNoError(t, cerr)
    test.AssertEqual(t, relCount as int, 2)
    hist, herr := listEntityHistory(pool, "guides/install", 50)
    test.AssertNoError(t, herr)
    test.AssertEqual(t, len(hist), 1)

func TestImportOKFRedactsSecrets(t: reference testing.T)
    pool, dir := p3Pool(t)
    defer p3Close(pool, dir)
    env.Unset("MIZUYA_SECRET_SCAN") onerr discard

    base := filepath.Join(dir, "proj")
    wdir := filepath.Join(base, "docs")
    test.AssertNoError(t, files.MkDirAll(wdir))
    test.AssertNoError(t, files.WriteString(
        "---\ntype: Guide\ntitle: Deploy\ndescription: uses key AKIAIOSFODNN7EXAMPLE internally\n---\n\nBody.\n",
        filepath.Join(wdir, "deploy.md"),
    ))

    imported, _, err := importOKF(pool, base, "docs", "okf")
    test.AssertNoError(t, err)
    test.AssertEqual(t, imported, 1)
    e, gerr := getEntity(pool, "deploy")
    test.AssertNoError(t, gerr)
    test.AssertFalse(
        t,
        strContains(e.Data, "AKIAIOSFODNN7EXAMPLE"),
        "imported summary must be redacted",
    )
    test.AssertContains(t, e.Data, "[REDACTED:aws-access-key]")

# --- secret gate scope: every stored free-text field ---

# The name is redacted in place like the summary; tags are redacted
# element-wise; the raw values never reach the row (or the FTS index,
# which mirrors the same column).
func TestUpsertRedactsNameAndTags(t: reference testing.T)
    pool, dir := p3Pool(t)
    defer p3Close(pool, dir)
    env.Unset("MIZUYA_SECRET_SCAN") onerr discard

    err := upsertEntity(
        pool,
        "deploy",
        "config",
        "Deploy key ghp_abcdefghijklmnopqrstuvwxyz0123456789ab",
        "s",
        list of string{"prod", "aws AKIAIOSFODNN7EXAMPLE"},
    )
    test.AssertNoError(t, err)
    e, gerr := getEntity(pool, "deploy")
    test.AssertNoError(t, gerr)
    test.AssertContains(t, e.Name, "[REDACTED:github-token]")
    test.AssertFalse(
        t,
        strContains(e.Name, "ghp_abcdefghijklmnopqrstuvwxyz0123456789ab"),
        "stored name must not contain the token",
    )
    test.AssertContains(t, e.Data, "[REDACTED:aws-access-key]")
    test.AssertFalse(
        t,
        strContains(e.Data, "AKIAIOSFODNN7EXAMPLE"),
        "stored tag must not contain the aws key",
    )

# A secret in the entity id cannot be redacted in place (ids are
# referential keys — relations, history, FTS, entity:// URIs), so the
# upsert is refused and nothing is stored.
func TestUpsertRefusesSecretInID(t: reference testing.T)
    pool, dir := p3Pool(t)
    defer p3Close(pool, dir)
    env.Unset("MIZUYA_SECRET_SCAN") onerr discard

    err := upsertEntity(
        pool,
        "ghp_abcdefghijklmnopqrstuvwxyz0123456789ab",
        "concept",
        "evil",
        "s",
        empty list of string,
    )
    test.AssertError(t, err)
    _, gerr := getEntity(pool, "ghp_abcdefghijklmnopqrstuvwxyz0123456789ab")
    test.AssertError(t, gerr)

# The fail-closed gate honors MIZUYA_SECRET_SCAN=off exactly like the
# redaction path does — nothing is scanned or refused.
func TestSecretScanOffAllowsIDSecret(t: reference testing.T)
    pool, dir := p3Pool(t)
    defer p3Close(pool, dir)
    env.Set("MIZUYA_SECRET_SCAN", "off") onerr discard

    err := upsertEntity(
        pool,
        "ghp_abcdefghijklmnopqrstuvwxyz0123456789ab",
        "concept",
        "ok",
        "s",
        empty list of string,
    )
    test.AssertNoError(t, err)
    env.Unset("MIZUYA_SECRET_SCAN") onerr discard

# The observation source label is free text too — it is redacted like
# the text, and addObservation returns the stored (redacted) text so
# callers echo what was actually written, never the raw input.
func TestObservationRedactsSourceAndReturnsStoredText(t: reference testing.T)
    pool, dir := p3Pool(t)
    defer p3Close(pool, dir)
    env.Unset("MIZUYA_SECRET_SCAN") onerr discard

    test.AssertNoError(
        t,
        upsertEntity(pool, "duck", "concept", "Donald Duck", "s", empty list of string),
    )
    n, stored, err := addObservation(
        pool,
        "duck",
        "aws key AKIAIOSFODNN7EXAMPLE was used",
        "ghp_abcdefghijklmnopqrstuvwxyz0123456789ab",
    )
    test.AssertNoError(t, err)
    test.AssertEqual(t, n, 2)
    test.AssertContains(t, stored, "[REDACTED:aws-access-key]")
    test.AssertFalse(
        t,
        strContains(stored, "AKIAIOSFODNN7EXAMPLE"),
        "returned text must be the stored (redacted) text",
    )
    obs, lerr := listObservations(pool, "duck")
    test.AssertNoError(t, lerr)
    test.AssertEqual(t, len(obs), 1)
    test.AssertContains(t, obs[0].Source, "[REDACTED:github-token]")

# Relation labels are free text as well; the stored (redacted) rel is
# returned so callers echo what was written.
func TestRelateRedactsRel(t: reference testing.T)
    pool, dir := p3Pool(t)
    defer p3Close(pool, dir)
    env.Unset("MIZUYA_SECRET_SCAN") onerr discard

    test.AssertNoError(t, upsertEntity(pool, "a", "concept", "A", "s", empty list of string))
    test.AssertNoError(t, upsertEntity(pool, "b", "concept", "B", "s", empty list of string))
    rel, rerr := relate(pool, "a", "uses ghp_abcdefghijklmnopqrstuvwxyz0123456789ab", "b")
    test.AssertNoError(t, rerr)
    test.AssertContains(t, rel, "[REDACTED:github-token]")
    outgoing, oerr := outgoingContext(pool, "a")
    test.AssertNoError(t, oerr)
    test.AssertEqual(t, len(outgoing), 1)
    test.AssertContains(t, outgoing[0].Rel, "[REDACTED:github-token]")
