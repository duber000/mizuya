# mizuya — model types
# A SQLite-backed knowledge graph with JSON columns, FTS5 keyword search,
# 1-hop context lookups, and vector cosine similarity (via a registered
# custom SQL function).

petiole main

# EntityType is the closed set of entity classifications.
# Stored as text in the entities.type column; ParseEntityType validates
# at boundaries (CLI flags, MCP tool arguments). AllEntityType() serves
# the valid-types list for flag help and tool schemas.
enum EntityType
    Project = "project"
    Tool = "tool"
    Person = "person"
    Concept = "concept"
    Config = "config"
    Org = "org"

# Entity is a node in the knowledge graph.
# The Data field holds a JSON object: {summary, observations, tags}.
type Entity
    Id: string as "id"
    Type: string as "type"
    Name: string as "name"
    Data: string as "data"
    CreatedAt: string as "created_at"
    UpdatedAt: string as "updated_at"

# Relation is a typed edge between two entities.
type Relation
    Src: string as "src"
    Rel: string as "rel"
    Dst: string as "dst"
    Data: string as "data"
    CreatedAt: string as "created_at"

# SearchHit is a single row from an FTS5 / hybrid search. Score is the
# RRF fusion score for hybrid results (0 for plain FTS rows); UpdatedAt
# is the entity's last-change timestamp, so callers can reason about
# recency instead of trusting rank alone.
type SearchHit
    Id: string as "id"
    Type: string as "type"
    Name: string as "name"
    Summary: string as "summary"
    UpdatedAt: string as "updated_at"
    Score: float64 as "score"

# SearchFilter narrows search results. Since/Until are YYYY-MM-DD dates
# (inclusive, applied to the entity's updated_at); empty means unbounded.
type SearchFilter
    Type: string as "type"
    Tag: string as "tag"
    Since: string as "since"
    Until: string as "until"

# ContextRow describes one end of a 1-hop neighbor edge.
type ContextRow
    Rel: string as "rel"
    Other: string as "other"
    Name: string as "name"
    Type: string as "type"
    Summary: string as "summary"

# ReachableRow describes an entity reached via N-hop graph traversal
# through the closure virtual table. Depth is the minimum hop count
# from the root; the relation label isn't carried (closure walks any
# edge regardless of `rel`).
type ReachableRow
    Depth: int as "depth"
    Other: string as "other"
    Name: string as "name"
    Type: string as "type"
    Summary: string as "summary"

# ObsRow is a single observation row from the observations table.
# Id is a uuid7 string assigned by SQLite at INSERT time. Supersedes
# names the observation this one corrects (empty when it corrects none).
# SupersededBy is the inverse link: the id of the observation that
# corrects this one (empty when nothing supersedes it) — so readers can
# see a stale fact is stale without acting on it.
type ObsRow
    Id: string as "id"
    Text: string as "text"
    Source: string as "source"
    At: string as "at"
    Supersedes: string as "supersedes"
    SupersededBy: string as "superseded_by"

# HistoryRow is one version of an entity from the append-only
# entity_history log. ChangedAt is when that state became current.
type HistoryRow
    Id: string as "id"
    EntityId: string as "entity_id"
    Type: string as "type"
    Name: string as "name"
    Data: string as "data"
    ChangedAt: string as "changed_at"

# SimilarHit is a single row from a vector similarity search.
type SimilarHit
    Id: string as "id"
    Name: string as "name"
    Type: string as "type"
    Summary: string as "summary"
    UpdatedAt: string as "updated_at"
    Distance: float64 as "distance"

# DriftRow is one observation whose entity's conception changed after the
# observation was recorded (used by the drift command / listDrift).
type DriftRow
    ObsId: string as "obs_id"
    EntityId: string as "entity_id"
    EntityName: string as "entity_name"
    ObsText: string as "obs_text"
    ObsAt: string as "obs_at"
    EntityUpdated: string as "entity_updated"

# hashRow scans the content_hash column for change detection.
type hashRow
    Hash: string as "hash"

# sqlRow scans DDL text out of the sqlite_schema table.
type sqlRow
    SQL: string as "sql"

# suggestRow is a single fuzzy-match suggestion from the spellfix1
# vtab. Word is the matched id; we don't currently surface rank or
# distance.
type suggestRow
    Word: string as "word"

# entityData is the typed view of the JSON stored in the entities.data
# column. Unknown fields (like observations) are ignored on unmarshal.
type entityData
    Summary: string as "summary"
    Tags: list of string as "tags"

# vecRow scans a stored float32 LE BLOB from the embeddings_raw side
# table (the vec1 vtab is write/search only — see schema.kuki).
type vecRow
    Vec: list of byte as "vec"

# EmbedDim is the dimensionality of the fallback hash embedding.
# Real providers (ollama, openai) determine dim from the model output.
const EmbedDim: int = 64

# EmbedModel is the fallback model tag when no provider is configured.
const EmbedModel: string = "hash-demo-64"
