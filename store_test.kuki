# mizuya — tests for the append-only belief log (entity_history,
# observation supersedes), time-bounded reads, and search filters.
#
# Internal test package (petiole main) so tests can call the
# unexported store/search functions directly.

petiole main

import "os"
import "path/filepath"
import "stdlib/db"
import "stdlib/slice"
import "stdlib/test"
import "testing"

# todayDate returns the current UTC date as YYYY-MM-DD, straight from
# SQLite so tests and schema share one clock.
func todayDate(pool: db.Pool) (string, error)
    return db.QueryRow(pool, "SELECT date('now')") |> db.ScanRow of string

# --- entity_history: append-only versions ---

func TestUpsertAppendsHistory(t: reference testing.T)
    pool, dir := openTestPool(t)
    defer closeTestPool(pool, dir)

    _, uerr := upsertEntity(
        pool,
        "duck",
        "concept",
        "Donald Duck",
        "v1: kids cartoon",
        list of string{"disney"},
    )
    test.AssertNoError(t, uerr)

    hist, err := listEntityHistory(pool, "duck", 50)
    test.AssertNoError(t, err)
    test.AssertEqual(t, len(hist), 1)
    test.AssertContains(t, hist[0].Data, "v1")

    # A no-op upsert (identical state) must not spam the log.
    _, uerr2 := upsertEntity(
        pool,
        "duck",
        "concept",
        "Donald Duck",
        "v1: kids cartoon",
        list of string{"disney"},
    )
    test.AssertNoError(t, uerr2)
    hist, err = listEntityHistory(pool, "duck", 50)
    test.AssertNoError(t, err)
    test.AssertEqual(t, len(hist), 1)

    # A real change appends the new state; the old one stays in the log.
    _, uerr3 := upsertEntity(
        pool,
        "duck",
        "concept",
        "Donald Duck",
        "v2: also a meme",
        list of string{"disney"},
    )
    test.AssertNoError(t, uerr3)
    hist, err = listEntityHistory(pool, "duck", 50)
    test.AssertNoError(t, err)
    test.AssertEqual(t, len(hist), 2)
    # Newest first.
    test.AssertContains(t, hist[0].Data, "v2")
    test.AssertContains(t, hist[1].Data, "v1")

    # The live row is the current view; history is the log.
    e, gerr := getEntity(pool, "duck")
    test.AssertNoError(t, gerr)
    test.AssertContains(t, e.Data, "v2")

func TestEntityStateAt(t: reference testing.T)
    pool, dir := openTestPool(t)
    defer closeTestPool(pool, dir)

    _, uerr4 := upsertEntity(pool, "duck", "concept", "Donald Duck", "v1", empty list of string)
    test.AssertNoError(t, uerr4)
    _, uerr5 := upsertEntity(pool, "duck", "concept", "Donald Duck", "v2", empty list of string)
    test.AssertNoError(t, uerr5)

    # As of today (end of day): the latest version.
    today, terr := todayDate(pool)
    test.AssertNoError(t, terr)
    st, err := entityStateAt(pool, "duck", today)
    test.AssertNoError(t, err)
    test.AssertContains(t, st.Data, "v2")

    # As of a far-future date: still the latest.
    st, err = entityStateAt(pool, "duck", "2999-01-01")
    test.AssertNoError(t, err)
    test.AssertContains(t, st.Data, "v2")

    # As of before the entity existed: an error, not a silent empty row.
    _, err = entityStateAt(pool, "duck", "2000-01-01")
    test.AssertError(t, err)

    # Malformed date: rejected.
    _, err = entityStateAt(pool, "duck", "yesterday")
    test.AssertError(t, err)

# --- observations: supersedes links ---

func TestObservationSupersedes(t: reference testing.T)
    pool, dir := openTestPool(t)
    defer closeTestPool(pool, dir)

    _, uerr6 := upsertEntity(pool, "duck", "concept", "Donald Duck", "s", empty list of string)
    test.AssertNoError(t, uerr6)
    _, uerr7 := upsertEntity(pool, "other", "concept", "Other", "s", empty list of string)
    test.AssertNoError(t, uerr7)

    _, _, aerr := addObservation(pool, "duck", "first belief", "conversation")
    test.AssertNoError(t, aerr)
    obs, err := listObservations(pool, "duck")
    test.AssertNoError(t, err)
    test.AssertEqual(t, len(obs), 1)
    first := obs[0]
    test.AssertEqual(t, first.Supersedes, "")

    # Correcting observation links to the one it corrects.
    _, _, aerr = addObservation(pool, "duck", "corrected belief", "conversation", first.Id)
    test.AssertNoError(t, aerr)
    obs, err = listObservations(pool, "duck")
    test.AssertNoError(t, err)
    test.AssertEqual(t, len(obs), 2)
    test.AssertEqual(t, obs[0].Supersedes, first.Id)
    test.AssertEqual(t, obs[1].Id, first.Id)

    # Bogus supersedes id: fail-closed error.
    _, _, err = addObservation(pool, "duck", "x", "conversation", "no-such-uuid")
    test.AssertError(t, err)

    # Observation on a different entity: also rejected.
    _, _, aerr = addObservation(pool, "other", "o", "conversation")
    test.AssertNoError(t, aerr)
    otherObs, err := listObservations(pool, "other")
    test.AssertNoError(t, err)
    _, _, err = addObservation(pool, "duck", "x", "conversation", otherObs[0].Id)
    test.AssertError(t, err)

func TestListObservationsRange(t: reference testing.T)
    pool, dir := openTestPool(t)
    defer closeTestPool(pool, dir)

    _, uerr8 := upsertEntity(pool, "duck", "concept", "Donald Duck", "s", empty list of string)
    test.AssertNoError(t, uerr8)
    _, _, aerr := addObservation(pool, "duck", "one", "conversation")
    test.AssertNoError(t, aerr)
    _, _, aerr = addObservation(pool, "duck", "two", "conversation")
    test.AssertNoError(t, aerr)

    today, terr := todayDate(pool)
    test.AssertNoError(t, terr)
    obs, err := listObservationsRange(pool, "duck", today, today, false)
    test.AssertNoError(t, err)
    test.AssertEqual(t, len(obs), 2)

    obs, err = listObservationsRange(pool, "duck", "", "2000-01-01", false)
    test.AssertNoError(t, err)
    test.AssertEqual(t, len(obs), 0)

    _, err = listObservationsRange(pool, "duck", "01/02/2026", "", false)
    test.AssertError(t, err)

# --- search filters ---

func seedSearchEntities(t: reference testing.T, pool: db.Pool)
    _, uerr9 := upsertEntity(
        pool,
        "sqlite",
        "tool",
        "SQLite",
        "Embedded SQL database engine",
        list of string{"db", "embedded"},
    )
    test.AssertNoError(t, uerr9)
    _, uerr10 := upsertEntity(
        pool,
        "kukicha",
        "project",
        "Kukicha",
        "Go superset with pipes and onerr",
        list of string{"lang"},
    )
    test.AssertNoError(t, uerr10)
    _, uerr11 := upsertEntity(
        pool,
        "vec1",
        "tool",
        "vec1",
        "Vector extension for KNN search",
        list of string{"db", "vector"},
    )
    test.AssertNoError(t, uerr11)

func TestSearchFilters(t: reference testing.T)
    pool, dir := openTestPool(t)
    defer closeTestPool(pool, dir)
    seedSearchEntities(t, pool)

    # Type filter.
    hits, err := ftsSearch(pool, "database", 10, SearchFilter{Type: "tool"})
    test.AssertNoError(t, err)
    for h in hits
        test.AssertEqual(t, h.Type, "tool")
    test.AssertTrue(t, hits isnt empty, "expected tool hits")

    # Tag filter.
    hits, err = ftsSearch(pool, "search", 10, SearchFilter{Tag: "vector"})
    test.AssertNoError(t, err)
    test.AssertEqual(t, len(hits), 1)
    test.AssertEqual(t, hits[0].Id, "vec1")

    # Invalid dates are errors, not silent empty results.
    _, err = ftsSearch(pool, "database", 10, SearchFilter{Since: "yesterday"})
    test.AssertError(t, err)
    _, err = hybridSearch(pool, "database", 10, SearchFilter{Until: "2026-13-99"})
    test.AssertError(t, err)

func TestHybridSearchHitShape(t: reference testing.T)
    pool, dir := openTestPool(t)
    defer closeTestPool(pool, dir)
    seedSearchEntities(t, pool)
    _, rerr := reEmbedIfChanged(pool, "sqlite")
    test.AssertNoError(t, rerr)
    _, rerr = reEmbedIfChanged(pool, "kukicha")
    test.AssertNoError(t, rerr)
    _, rerr = reEmbedIfChanged(pool, "vec1")
    test.AssertNoError(t, rerr)

    hits, err := hybridSearch(pool, "embedded database", 10)
    test.AssertNoError(t, err)
    test.AssertTrue(t, hits isnt empty, "expected hits")
    for h in hits
        # Every hit carries provenance-ish metadata: recency + why it ranked.
        test.AssertTrue(t, h.UpdatedAt isnt empty, "updated_at must be set")
        test.AssertTrue(t, h.Score > 0.0, "RRF score must be positive")
    # Best hit for this query should be sqlite.
    test.AssertEqual(t, hits[0].Id, "sqlite")

    # since/until threaded through hybrid: far-past until matches nothing.
    hits, err = hybridSearch(pool, "database", 10, SearchFilter{Until: "2000-01-01"})
    test.AssertNoError(t, err)
    test.AssertEqual(t, len(hits), 0)

func TestListDrift(t: reference testing.T)
    pool, dir := openTestPool(t)
    defer closeTestPool(pool, dir)

    _, uerr12 := upsertEntity(pool, "duck", "concept", "Donald Duck", "v1", empty list of string)
    test.AssertNoError(t, uerr12)
    _, _, aerr := addObservation(pool, "duck", "stale belief", "conversation")
    test.AssertNoError(t, aerr)
    obs, err := listObservations(pool, "duck")
    test.AssertNoError(t, err)
    first := obs[0]

    # No entity change after the observation yet: no drift.
    rows, err := listDrift(pool, 50, false)
    test.AssertNoError(t, err)
    test.AssertEqual(t, len(rows), 0)

    # Simulate a later entity change (deterministic future timestamp).
    db.Exec(
        pool,
        "INSERT INTO entity_history (entity_id, type, name, data, changed_at) VALUES ('duck', 'concept', 'Donald Duck', '{}', datetime('now', '+1 second'))",
    ) onerr discard

    # Now the observation is drifted.
    rows, err = listDrift(pool, 50, false)
    test.AssertNoError(t, err)
    test.AssertEqual(t, len(rows), 1)
    test.AssertEqual(t, rows[0].ObsId, first.Id)

    # A superseding observation makes the old one a deliberate correction:
    # excluded by default (the new observation is itself drifted by the
    # simulated change), included with includeSuperseded=true.
    _, _, aerr = addObservation(pool, "duck", "corrected belief", "conversation", first.Id)
    test.AssertNoError(t, aerr)
    rows, err = listDrift(pool, 50, false)
    test.AssertNoError(t, err)
    test.AssertEqual(t, len(rows), 1)
    test.AssertTrue(t, rows[0].ObsId isnt first.Id, "superseded obs must be excluded by default")
    rows, err = listDrift(pool, 50, true)
    test.AssertNoError(t, err)
    test.AssertEqual(t, len(rows), 2)
    ids := rows |> slice.Map(r => r.ObsId)
    test.AssertContains(t, ids, first.Id)

func TestRegexSearchFilter(t: reference testing.T)
    pool, dir := openTestPool(t)
    defer closeTestPool(pool, dir)
    seedSearchEntities(t, pool)

    hits, err := regexSearch(pool, '^sqlite$', 10, SearchFilter{Tag: "embedded"})
    test.AssertNoError(t, err)
    test.AssertEqual(t, len(hits), 1)
    test.AssertEqual(t, hits[0].Id, "sqlite")

    hits, err = regexSearch(pool, '^sqlite$', 10, SearchFilter{Tag: "lang"})
    test.AssertNoError(t, err)
    test.AssertEqual(t, len(hits), 0)

# --- consumer-contract pins ---

# TestObservationOrderingPinned: context --json observations are always
# newest-first (at DESC, id DESC) — consumers take the first N as "most
# recent", so this ordering is contractual, not incidental.
func TestObservationOrderingPinned(t: reference testing.T)
    pool, dir := openTestPool(t)
    defer closeTestPool(pool, dir)

    _, uerr13 := upsertEntity(pool, "duck", "concept", "Donald Duck", "s", empty list of string)
    test.AssertNoError(t, uerr13)
    _, _, aerr := addObservation(pool, "duck", "first", "conversation")
    test.AssertNoError(t, aerr)
    _, _, aerr = addObservation(pool, "duck", "second", "conversation")
    test.AssertNoError(t, aerr)
    _, _, aerr = addObservation(pool, "duck", "third", "conversation")
    test.AssertNoError(t, aerr)

    obs, err := listObservations(pool, "duck")
    test.AssertNoError(t, err)
    test.AssertEqual(t, len(obs), 3)
    # Newest first: strictly non-increasing timestamps, and ids DESC on ties.
    test.AssertEqual(t, obs[0].Text, "third")
    test.AssertEqual(t, obs[2].Text, "first")
    for i from 1 to len(obs)
        test.AssertTrue(t, obs[i - 1].At >= obs[i].At, "at must be non-increasing at index {i}")
        if obs[i - 1].At equals obs[i].At
            test.AssertTrue(t, obs[i - 1].Id > obs[i].Id, "id tiebreak must be DESC at index {i}")

# TestSupersededByFlag: context output flags superseded observations via
# superseded_by, and hideSuperseded drops them.
func TestSupersededByFlag(t: reference testing.T)
    pool, dir := openTestPool(t)
    defer closeTestPool(pool, dir)

    _, uerr14 := upsertEntity(pool, "duck", "concept", "Donald Duck", "s", empty list of string)
    test.AssertNoError(t, uerr14)
    _, _, aerr := addObservation(pool, "duck", "stale fact", "conversation")
    test.AssertNoError(t, aerr)
    obs, err := listObservations(pool, "duck")
    test.AssertNoError(t, err)
    stale := obs[0]
    test.AssertEqual(t, stale.SupersededBy, "")

    _, _, aerr = addObservation(pool, "duck", "corrected fact", "conversation", stale.Id)
    test.AssertNoError(t, aerr)

    obs, err = listObservations(pool, "duck")
    test.AssertNoError(t, err)
    test.AssertEqual(t, len(obs), 2)
    # obs[0] = corrected (newest), obs[1] = stale, flagged.
    test.AssertEqual(t, obs[0].Supersedes, stale.Id)
    test.AssertEqual(t, obs[0].SupersededBy, "")
    test.AssertEqual(t, obs[1].Id, stale.Id)
    test.AssertEqual(t, obs[1].SupersededBy, obs[0].Id)

    # hideSuperseded drops the stale one.
    obs, err = listObservationsRange(pool, "duck", "", "", true)
    test.AssertNoError(t, err)
    test.AssertEqual(t, len(obs), 1)
    test.AssertEqual(t, obs[0].Text, "corrected fact")

# --- prune-history ---

func TestPruneHistory(t: reference testing.T)
    pool, dir := openTestPool(t)
    defer closeTestPool(pool, dir)

    _, uerr15 := upsertEntity(pool, "duck", "concept", "Donald Duck", "v1", empty list of string)
    test.AssertNoError(t, uerr15)
    # Insert 4 more versions with deterministic future timestamps so the
    # newest-first order is v5, v4, v3, v2, then the real upsert (v1).
    for i from 2 through 5
        db.Exec(
            pool,
            "INSERT INTO entity_history (entity_id, type, name, data, changed_at) VALUES ('duck', 'concept', 'Donald Duck', ?, ?)",
            `{"summary":"v${i}"}`,
            "2027-01-0{i} 10:00:00.000",
        ) onerr discard

    hist, err := listEntityHistory(pool, "duck", 50)
    test.AssertNoError(t, err)
    test.AssertEqual(t, len(hist), 5)

    # dry-run keep=2 counts without deleting.
    n, perr := pruneHistory(pool, 2, "", true)
    test.AssertNoError(t, perr)
    test.AssertEqual(t, n, 3)
    hist, err = listEntityHistory(pool, "duck", 50)
    test.AssertNoError(t, err)
    test.AssertEqual(t, len(hist), 5)

    # keep=2 retains the newest 2 (v5, v4).
    n, perr = pruneHistory(pool, 2, "", false)
    test.AssertNoError(t, perr)
    test.AssertEqual(t, n, 3)
    hist, err = listEntityHistory(pool, "duck", 50)
    test.AssertNoError(t, err)
    test.AssertEqual(t, len(hist), 2)
    test.AssertContains(t, hist[0].Data, "v5")
    test.AssertContains(t, hist[1].Data, "v4")

    # before=2027-01-04 drops versions older than end of that day (v4),
    # but never the newest (v5).
    n, perr = pruneHistory(pool, 0, "2027-01-04", false)
    test.AssertNoError(t, perr)
    test.AssertEqual(t, n, 1)
    hist, err = listEntityHistory(pool, "duck", 50)
    test.AssertNoError(t, err)
    test.AssertEqual(t, len(hist), 1)
    test.AssertContains(t, hist[0].Data, "v5")

    # Neither flag: error (fail-closed against accidental full prune).
    _, perr = pruneHistory(pool, 0, "", false)
    test.AssertError(t, perr)

    # Bad date: error.
    _, perr = pruneHistory(pool, 0, "not-a-date", false)
    test.AssertError(t, perr)

func TestPruneHistoryBeforeKeepsNewest(t: reference testing.T)
    pool, dir := openTestPool(t)
    defer closeTestPool(pool, dir)

    _, uerr16 := upsertEntity(pool, "duck", "concept", "Donald Duck", "v1", empty list of string)
    test.AssertNoError(t, uerr16)
    db.Exec(
        pool,
        "INSERT INTO entity_history (entity_id, type, name, data, changed_at) VALUES ('duck', 'concept', 'Donald Duck', ?, '2026-01-01 10:00:00.000')",
        `{"summary":"old"}`,
    ) onerr discard

    # Pruning "everything before 2999" must still keep the newest row.
    n, err := pruneHistory(pool, 0, "2999-01-01", false)
    test.AssertNoError(t, err)
    test.AssertEqual(t, n, 1) # only the old row
    hist, herr := listEntityHistory(pool, "duck", 50)
    test.AssertNoError(t, herr)
    test.AssertEqual(t, len(hist), 1)
    test.AssertContains(t, hist[0].Data, "v1")

# TestPruneHistoryKeepAndBeforeUnion: with BOTH --keep and --before set, a
# version is pruned only when it breaks both bounds — beyond the keep window
# AND older than the cutoff. A version inside the keep window is kept even
# when old; a version after the cutoff is kept even when it ranks beyond
# --keep (union retention). The newest version per entity is always kept.
func TestPruneHistoryKeepAndBeforeUnion(t: reference testing.T)
    pool, dir := openTestPool(t)
    defer closeTestPool(pool, dir)

    _, uerr17 := upsertEntity(pool, "duck", "concept", "Donald Duck", "v1", empty list of string)
    test.AssertNoError(t, uerr17)
    # Two future versions; the upsert's own row stays at rn = 3 (old).
    # Deterministic: R1 (2030-01-02) is old relative to the 2028 cutoff
    # but inside keep = 2; the upsert row (2026) is old AND beyond it.
    db.Exec(
        pool,
        `INSERT INTO entity_history (entity_id, type, name, data, changed_at) VALUES ('duck', 'concept', 'Donald Duck', '{"summary":"R1"}', '2030-01-02 10:00:00.000')`,
    ) onerr discard
    db.Exec(
        pool,
        `INSERT INTO entity_history (entity_id, type, name, data, changed_at) VALUES ('duck', 'concept', 'Donald Duck', '{"summary":"R2"}', '2030-01-09 10:00:00.000')`,
    ) onerr discard

    # dry-run counts only the rank-3 old row (the union keeps R1).
    n, perr := pruneHistory(pool, 2, "2028-01-01", true)
    test.AssertNoError(t, perr)
    test.AssertEqual(t, n, 1)

    # Same count for real; R1 and R2 survive (R1 is old but inside keep=2).
    n, perr = pruneHistory(pool, 2, "2028-01-01", false)
    test.AssertNoError(t, perr)
    test.AssertEqual(t, n, 1)
    hist, herr := listEntityHistory(pool, "duck", 10)
    test.AssertNoError(t, herr)
    test.AssertEqual(t, len(hist), 2)

# --- openPoolAt self-initializes uninitialized paths ---

# TestOpenPoolAtSelfInitializes: opening a path that was never
# `mizuya init`'d must not fail with "no such table" — initDB runs on open
# and the fuzzy vtab is populated, so writes and fuzzy suggestions work.
func TestOpenPoolAtSelfInitializes(t: reference testing.T)
    dir, err := os.MkdirTemp("", "mizuya-open-")
    if err isnt empty
        t.Fatalf("mktemp: %v", err)
    defer
        os.RemoveAll(dir) onerr discard
    path := filepath.Join(dir, "fresh.db")

    pool, oerr := openPoolAt(path)
    test.AssertNoError(t, oerr)

    _, uerr18 := upsertEntity(pool, "duck", "concept", "Donald Duck", "s", empty list of string)
    test.AssertNoError(t, uerr18)
    _, _, aerr := addObservation(pool, "duck", "hello", "conversation")
    test.AssertNoError(t, aerr)

    rows, lerr := listEntities(pool, "", 10)
    test.AssertNoError(t, lerr)
    test.AssertEqual(t, len(rows), 1)

    # The fuzzy vtab exists (no "no such table" error); it is populated at
    # open time, so refresh it after the upsert and the id resolves.
    _, serr := suggestIds(pool, "duck", 3)
    test.AssertNoError(t, serr)
    test.AssertNoError(t, refreshFuzzyIds(pool))
    ids, serr := suggestIds(pool, "duck", 3)
    test.AssertNoError(t, serr)
    test.AssertContains(t, ids, "duck")

    db.Close(pool) onerr discard

    # Re-opening the same path is a no-op, not an error.
    pool2, oerr := openPoolAt(path)
    test.AssertNoError(t, oerr)
    defer db.Close(pool2)
    rows, lerr = listEntities(pool2, "", 10)
    test.AssertNoError(t, lerr)
    test.AssertEqual(t, len(rows), 1)
